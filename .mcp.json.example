{
  "_note": "[PHASE B / ASPIRATIONAL 2026-06-13] The cast-memory server below was never built. This example describes future Phase B architecture. Only the github entry is live today. See docs/mcp-resources-decision.md.",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "cast-memory": {
      "command": "python3",
      "args": ["${HOME}/Projects/personal/claude-agent-team/scripts/cast-mcp-memory-server.py"],
      "env": {
        "CAST_DB_PATH": "${HOME}/.claude/cast.db"
      }
    }
  }
}
