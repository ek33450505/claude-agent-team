_memory_show() {
  _require_db

  local memory_id="${1:-}"
  if [ -z "$memory_id" ]; then
    _error "Usage: cast memory show <memory-id>"
    return 1
  fi

  python3 - "$CAST_DB_PATH" "$memory_id" "$CAST_JSON" <<'PYEOF'
import sys, sqlite3, json

db_path, mem_id, json_mode = sys.argv[1:4]
json_out = json_mode == "1"

conn = sqlite3.connect(db_path)
conn.row_factory = sqlite3.Row
cur = conn.cursor()
cur.execute("SELECT * FROM agent_memories WHERE id = ?", (mem_id,))
row = cur.fetchone()
conn.close()

if not row:
  print(f"Memory {mem_id} not found.", file=__import__('sys').stderr)
  sys.exit(1)

if json_out:
  print(json.dumps(dict(row), indent=2))
else:
  r = dict(row)
  print(f"[{r['id']}] {r['agent']} / {r['type']}")
  print(f"Name: {r['name']}")
  print(f"Description: {r['description'] or '(none)'}")
  print(f"Confidence: {r.get('confidence', 1.0)}")
  print(f"Last Verified: {r.get('last_validated_at', '(never)')}")
  print(f"Created: {r['created_at']}")
  print()
  print("Content:")
  print("-" * 80)
  print(r['content'] or '(empty)')
PYEOF
}

