}

_memory_delete() {
  _require_db

  local memory_id="${1:-}"
  if [ -z "$memory_id" ]; then
    _error "Usage: cast memory delete <memory-id>"
    return 1
  fi

  python3 - "$CAST_DB_PATH" "$memory_id" <<'PYEOF'
import sys, sqlite3
db_path, mem_id = sys.argv[1], sys.argv[2]
conn = sqlite3.connect(db_path)
cur = conn.cursor()
cur.execute("DELETE FROM agent_memories WHERE id = ?", (mem_id,))
conn.commit()
affected = cur.rowcount
conn.close()
if affected == 0:
  print(f"Memory {mem_id} not found.", file=__import__('sys').stderr)
  sys.exit(1)
print(f"Memory {mem_id} deleted.")
PYEOF
}

# ── Subcommand: budget ───────────────────────────────────────────────────────
_cmd_budget() {
  local show_week=0
  local project_filter=""

  # `cast budget set ...` — configure a budget limit (writer). cast-budget-alert.sh
  # reads the scope='global'/period='daily' row to fire spend warnings.
  if [ "${1:-}" = "set" ]; then
    shift
    local b_scope="global" b_period="daily" b_limit="" b_alert="0.80"
    while [ "${#}" -gt 0 ]; do
      case "$1" in
        --limit)    b_limit="${2:-}"; shift 2 ;;
        --alert-at) b_alert="${2:-}"; shift 2 ;;
        --scope)    b_scope="${2:-}"; shift 2 ;;
        --period)   b_period="${2:-}"; shift 2 ;;
        --help|-h)
          cat <<USAGE
Usage: cast budget set --limit <usd> [--alert-at <0-1>] [--scope global] [--period daily]

  --limit <usd>       Spend limit in USD (required)
  --alert-at <0-1>    Warn when spend reaches this fraction of the limit (default 0.80)
  --scope <name>      Budget scope (default: global)
  --period <name>     Budget period (default: daily)
USAGE
          return 0
          ;;
        *) shift ;;
      esac
    done
    if [ -z "$b_limit" ]; then
      _error "cast budget set requires --limit <usd>"
      return 1
    fi
    _require_db
    python3 - "$CAST_DB_PATH" "$b_scope" "$b_period" "$b_limit" "$b_alert" <<'PYEOF'
import sys, sqlite3
from datetime import datetime, timezone
db_path, scope, period, limit_usd, alert_at = sys.argv[1:6]
try:
    limit_val = float(limit_usd)
    alert_val = float(alert_at)
except ValueError:
    print("ERROR: --limit and --alert-at must be numbers", file=sys.stderr)
    sys.exit(1)
conn = sqlite3.connect(db_path, timeout=10)
# Defensive: ensure the table exists even on an un-migrated DB.
conn.execute(
    "CREATE TABLE IF NOT EXISTS budgets ("
    "  id INTEGER PRIMARY KEY AUTOINCREMENT, scope TEXT, scope_key TEXT, period TEXT,"
    "  limit_usd REAL, alert_at_pct REAL, created_at TEXT)"
)
# Upsert by (scope, period): clear any prior row then insert the new limit.
conn.execute("DELETE FROM budgets WHERE scope=? AND period=?", (scope, period))
conn.execute(
    "INSERT INTO budgets (scope, scope_key, period, limit_usd, alert_at_pct, created_at) "
    "VALUES (?, '*', ?, ?, ?, ?)",
    (scope, period, limit_val, alert_val, datetime.now(timezone.utc).isoformat())
)
conn.commit()
conn.close()
print(f"Budget set: {scope}/{period} limit=${limit_val:.2f} alert_at={alert_val*100:.0f}%")
PYEOF
    return 0
  fi

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --week)     show_week=1; shift ;;
      --project)  project_filter="${2:-}"; shift 2 ;;
      --help|-h)
        cat <<USAGE
Usage: cast budget [options]

  --week              Last 7 days grouped by date
  --project <name>    All-time spend for project
USAGE
        return 0
        ;;
      *) shift ;;
    esac
  done

  _require_db

  python3 - "$CAST_DB_PATH" "$show_week" "$project_filter" "$CAST_JSON" <<'PYEOF'
import sys, sqlite3, json
from datetime import datetime, timedelta, timezone

db_path, week_mode, project_f, json_mode = sys.argv[1:5]
show_week = week_mode == "1"
json_out = json_mode == "1"

conn = sqlite3.connect(db_path)
conn.row_factory = sqlite3.Row
cur = conn.cursor()

today = datetime.now(timezone.utc).strftime('%Y-%m-%d')
week_ago = (datetime.now(timezone.utc) - timedelta(days=7)).strftime('%Y-%m-%d')

cur.execute("SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs WHERE date(replace(replace(started_at,'T',' '),'Z',''))=?", (today,))
today_spend = cur.fetchone()[0] or 0.0

cur.execute("SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs WHERE date(replace(replace(started_at,'T',' '),'Z',''))>=?", (week_ago,))
week_spend = cur.fetchone()[0] or 0.0

cur.execute("SELECT COUNT(*) FROM agent_runs")
total_runs = cur.fetchone()[0] or 0

project_spend = None
if project_f:
    cur.execute("SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs WHERE project=?", (project_f,))
    project_spend = cur.fetchone()[0] or 0.0

week_rows = []
if show_week:
    cur.execute(
        """SELECT date(replace(replace(started_at,'T',' '),'Z','')) as day, COALESCE(SUM(cost_usd),0) as spend
           FROM agent_runs WHERE date(replace(replace(started_at,'T',' '),'Z',''))>=? GROUP BY day ORDER BY day DESC""",
        (week_ago,)
    )
    week_rows = [{"date": r["day"], "spend": r["spend"]} for r in cur.fetchall()]

conn.close()

if json_out:
    out = {
        "today_usd": round(today_spend, 4),
        "week_usd": round(week_spend, 4),
        "total_runs": total_runs,
    }
    if project_f:
        out["project"] = project_f
        out["project_spend_usd"] = round(project_spend, 4)
    if show_week:
        out["week_breakdown"] = week_rows
    print(json.dumps(out, indent=2))
    sys.exit(0)

print(f"Today: ${today_spend:.2f}  |  This week: ${week_spend:.2f}  |  Total runs: {total_runs}")
if project_f:
    print(f"Project '{project_f}': ${project_spend:.2f} all-time")
if show_week and week_rows:
    print()
    print("Week breakdown:")
    for r in week_rows:
        print(f"  {r['date']}: ${r['spend']:.4f}")
elif show_week:
    print("No spend data for the last 7 days.")
PYEOF
}

# ── Subcommand: doctor ───────────────────────────────────────────────────────
_cmd_doctor() {
  local overall_ok=1

  local OK="[${C_GREEN}ok${C_RESET}]"
  local WARN="[${C_YELLOW}!!${C_RESET}]"
  local ERR="[${C_RED}ERR${C_RESET}]"
  local INFO="[${C_CYAN}--${C_RESET}]"

  printf "${C_BOLD}CAST Doctor${C_RESET}\n"
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"

  # 1. cast.db accessible
  # Use sqlite_master (not SELECT 1) to force header validation — SELECT 1 is a
  # constant expression that succeeds even on corrupt/non-database files on some
  # sqlite versions (observed on Ubuntu sqlite 3.45: rc=0 on a "notadb" file).
  # Querying sqlite_master returns SQLITE_NOTADB (rc 26) on both platforms.
  if sqlite3 "$CAST_DB_PATH" 'SELECT count(*) FROM sqlite_master' >/dev/null 2>&1; then
    printf "%b cast.db accessible (%s)\n" "$OK" "$CAST_DB_PATH"
  else
    printf "%b cast.db not accessible (%s)\n" "$ERR" "$CAST_DB_PATH"
    overall_ok=0
    printf "\n  Run: bash %s/cast-db-init.sh\n" "$CAST_SCRIPTS_DIR"
    return 1
  fi

  # 2. Schema — every table cast-db-init.sh provisions (the single source of truth).
  # Keep in sync with cast-db-init.sh. Organic self-create tables (file_writes,
  # agent_hallucinations, etc.) are intentionally excluded — their writers create
  # them lazily, so they may legitimately be absent on a fresh install.
  local required_tables="sessions agent_runs routing_events agent_memories \
stream_events swarm_sessions teammate_runs teammate_messages tool_call_failures \
agent_truncations injection_log quality_gates dispatch_decisions task_queue \
routines incidents plan_sessions memory_consolidation_runs archived_memories budgets"
  local required_total
  required_total=$(printf '%s\n' $required_tables | grep -c .)
  local missing_tables=""
  local found_count=0
  for tbl in $required_tables; do
    if sqlite3 "$CAST_DB_PATH" "SELECT name FROM sqlite_master WHERE type='table' AND name='${tbl}';" 2>/dev/null | grep -q "${tbl}"; then
      found_count=$((found_count + 1))
    else
      missing_tables="${missing_tables} ${tbl}"
    fi
  done
  if [ -z "$missing_tables" ]; then
    printf "%b Schema: %d/%d provisioned tables present\n" "$OK" "$found_count" "$required_total"
  else
    printf "%b Schema: %d/%d tables found — missing:%s (run cast-db-init.sh)\n" "$WARN" "$found_count" "$required_total" "$missing_tables"
    overall_ok=0
  fi

  # 3. Hooks registered
  local settings_file="${HOME}/.claude/settings.json"
  local hook_count=0
  if [ -f "$settings_file" ]; then
    hook_count="$(python3 - "$settings_file" <<'PYEOF'
import json, sys
try:
    with open(sys.argv[1]) as f:
        cfg = json.load(f)
    hooks = cfg.get("hooks", {})
    total = sum(len(v) if isinstance(v, list) else 1 for v in hooks.values())
    print(total)
except Exception:
    print(0)
PYEOF
    2>/dev/null || echo 0)"
  fi
  if [ "${hook_count:-0}" -gt 3 ]; then
    printf "%b Hooks registered: %d entries\n" "$OK" "$hook_count"
  else
    printf "%b Hooks registered: only %d entries found\n" "$WARN" "$hook_count"
    overall_ok=0
  fi

  # 4. Hook scripts exist
  if [ -f "$settings_file" ]; then
    local missing_scripts
    missing_scripts="$(python3 - "$settings_file" <<'PYEOF'
import json, sys, os

try:
    with open(sys.argv[1]) as f:
        cfg = json.load(f)
    hooks = cfg.get("hooks", {})
except Exception:
    sys.exit(0)

missing = []
interpreters = {"bash", "sh", "python3", "python", "node"}
for event, entries in hooks.items():
    if not isinstance(entries, list):
        entries = [entries]
    for entry in entries:
        inner = entry.get("hooks", []) if isinstance(entry, dict) else []
        for h in inner:
            if not isinstance(h, dict):
                continue
            cmd = h.get("command", "")
            if not cmd:
                continue
            for part in cmd.split():
                if part in interpreters or part.startswith("-"):
                    continue
                expanded = os.path.expanduser(part)
                if "/" in expanded and not os.path.isfile(expanded):
                    missing.append(expanded)
                break

for m in missing:
    print(m)
PYEOF
    2>/dev/null || echo "")"
    if [ -z "$missing_scripts" ]; then
      printf "%b Hook scripts: all found\n" "$OK"
    else
      while IFS= read -r script_path; do
        [ -z "$script_path" ] && continue
        printf "%b Hook script missing: %s\n" "$ERR" "$script_path"
        overall_ok=0
      done <<< "$missing_scripts"
    fi
  fi

  # 5. Events dir writable
  local events_dir="${HOME}/.claude/cast/events"
  if [ -d "$events_dir" ] && [ -w "$events_dir" ]; then
    printf "%b Events dir writable\n" "$OK"
  elif [ -d "$events_dir" ]; then
    printf "%b Events dir not writable: %s\n" "$WARN" "$events_dir"
    overall_ok=0
  else
    printf "%b Events dir missing: %s\n" "$WARN" "$events_dir"
    overall_ok=0
  fi

  # 6. Agent count
  local agent_count=0
  if [ -d "$CAST_AGENTS_DIR" ]; then
    agent_count="$(ls "$CAST_AGENTS_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')"
  fi
  printf "%b Agents: %d installed\n" "$INFO" "$agent_count"

  # 7. BATS available
  if command -v bats >/dev/null 2>&1; then
    printf "%b BATS available\n" "$OK"
  else
    printf "%b BATS not found (install: brew install bats-core)\n" "$WARN"
    overall_ok=0
  fi

  # 8. Database migrations
  local migrate_script="${CAST_SCRIPTS_DIR}/cast-migrate.py"
  if [ ! -f "$migrate_script" ]; then
    migrate_script="${CAST_REPO_DIR}/scripts/cast-migrate.py"
  fi
  if [ -f "$migrate_script" ]; then
    # Use --dry-run so doctor is READ-ONLY — it must never apply migrations.
    local migration_output
    migration_output=$(python3 "$migrate_script" --dry-run 2>&1 || true)
    local pending_count
    pending_count=$(echo "$migration_output" | grep -c '^\s*\[PENDING\]' 2>/dev/null || true)
    pending_count=${pending_count:-0}
    local total_count
    total_count=$(sqlite3 "$CAST_DB_PATH" "SELECT COUNT(*) FROM schema_migrations;" 2>/dev/null || echo 0)
    # Count migration files on disk to detect empty-ledger-with-files condition
    local migrations_dir="${CAST_SCRIPTS_DIR}/migrations"
    local files_on_disk=0
    if [ -d "$migrations_dir" ]; then
      files_on_disk=$(find "$migrations_dir" -maxdepth 1 -name '[0-9]*_*.sql' | wc -l | tr -d ' ')
    fi
    if [ "$total_count" -eq 0 ] && [ "$files_on_disk" -gt 0 ]; then
      printf "%b Migrations: ledger empty (%d files on disk) — run: cast migrate\n" "$WARN" "$files_on_disk"
      overall_ok=0
    elif [ "$pending_count" -gt 0 ]; then
      printf "%b Migrations: %d pending — run: cast migrate\n" "$WARN" "$pending_count"
      overall_ok=0
    else
      printf "%b Migrations: up to date (%d recorded)\n" "$OK" "$total_count"
    fi
  else
    printf "%b Migrations: cast-migrate.py not found — run: bash install.sh\n" "$WARN"
    overall_ok=0
  fi

  # 9. Stale auto-memory check
  local stale_output
  stale_output=$(python3 << 'PYEOF' 2>/dev/null || echo "0"
import os
import re
from datetime import datetime

home = os.path.expanduser("~")
projects_dir = os.path.join(home, ".claude", "projects")

stale = []
try:
  for proj_dir in os.listdir(projects_dir):
    memory_dir = os.path.join(projects_dir, proj_dir, "memory")
    if not os.path.isdir(memory_dir):
      continue

    for fname in os.listdir(memory_dir):
      if fname == "MEMORY.md" or not fname.endswith(".md"):
        continue

      fpath = os.path.join(memory_dir, fname)
      try:
        with open(fpath, 'r') as f:
          content = f.read()
      except:
        continue

      # Parse frontmatter
      if not content.startswith('---'):
        continue

      parts = content.split('---')
      if len(parts) < 3:
        continue

      frontmatter = parts[1]
      body = '---'.join(parts[2:])

      # Extract verified_at
      verified_at = None
      for line in frontmatter.split('\n'):
        if line.startswith('verified_at:'):
          match = re.search(r'(\d{4}-\d{2}-\d{2})', line)
          if match:
            verified_at = match.group(1)
          break

      if not verified_at:
        continue

      # Check age
      try:
        vdate = datetime.strptime(verified_at, '%Y-%m-%d')
        today = datetime.utcnow()
        age_days = (today - vdate).days
      except:
        continue

      if age_days <= 30:
        continue

      # Check if body names paths/functions/flags
      has_specific = bool(
        re.search(r'/scripts/', body) or
        re.search(r'~/.claude/', body) or
        re.search(r'\w+\(\)', body) or
        re.search(r'--\w+', body)
      )

      if has_specific:
        stale.append((fpath, verified_at, age_days))

except:
  pass

print(len(stale))
for fpath, vdate, age in sorted(stale)[:10]:
  print(f"{fpath}|{vdate}|{age}")
PYEOF
)

  local stale_count
  stale_count=$(echo "$stale_output" | head -1 | tr -d ' ')
  stale_count=${stale_count:-0}

  if [ "$stale_count" -gt 0 ]; then
    printf "%b Stale memories: %d flagged (verified_at > 30 days, names specific paths/flags)\n" "$WARN" "$stale_count"
    while IFS='|' read -r fpath vdate age; do
      [[ -z "$fpath" ]] && continue
      printf "      %s (verified %s, %d days ago)\n" "$fpath" "$vdate" "$age"
    done <<< "$(echo "$stale_output" | tail -n +2)"
    if [ "$stale_count" -gt 10 ]; then
      printf "      ... and %d more\n" $((stale_count - 10))
    fi
  else
    printf "%b Stale memories: none\n" "$OK"
  fi

  # 10. Pending memory review queue
  local pending_count
  pending_count=$(python3 << 'PYEOF' 2>/dev/null || echo 0
import os
home = os.path.expanduser("~")
projects_dir = os.path.join(home, ".claude", "projects")
count = 0
try:
  for proj_dir in os.listdir(projects_dir):
    pending_dir = os.path.join(projects_dir, proj_dir, "memory", "_pending")
    if os.path.isdir(pending_dir):
      for f in os.listdir(pending_dir):
        if f.endswith(".md") and f != "MEMORY.md":
          count += 1
except:
  pass
print(count)
PYEOF
  )
  if [ "${pending_count:-0}" -gt 0 ]; then
    printf "%b Pending memory review: %d entries (run: cast memory review)\n" "$WARN" "$pending_count"
  else
    printf "%b Pending memory review: queue empty\n" "$OK"
  fi

  # 11. Version
  printf "%b Version: %s\n" "$INFO" "$CAST_VERSION"

  # 12. Slowest agents this week
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  printf "${C_BOLD}Slowest agents this week${C_RESET}\n"
  local slow_rows
  slow_rows="$(sqlite3 "$CAST_DB_PATH" \
    "SELECT matched_route, COUNT(*) as slow_count, MAX(CAST(json_extract(data,'$.duration_ms') AS INTEGER)) as max_ms \
     FROM routing_events \
     WHERE event_type='slow_agent' AND timestamp >= datetime('now','-7 days') \
     GROUP BY matched_route ORDER BY max_ms DESC LIMIT 5;" 2>/dev/null || true)"
  if [[ -z "$slow_rows" ]]; then
    printf "  (no slow_agent events this week)\n"
  else
    while IFS='|' read -r agent count max_ms; do
      [[ -z "$agent" ]] && continue
      printf "  %-20s %3d slow run(s)  max=%sms\n" "$agent" "$count" "$max_ms"
    done <<< "$slow_rows"
  fi

  # 13. Honesty surface — reads agent_hallucinations, completeness_events,
  #     agent_protocol_violations, code_ref_checks. Diagnostic only: failures
  #     inside this block never flip overall_ok or exit cast doctor early.
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  printf "${C_BOLD}Honesty signals (last 7d)${C_RESET}\n"
  if ! command -v sqlite3 >/dev/null 2>&1; then
    printf "%b honesty: cast.db unavailable (sqlite3 not found)\n" "$INFO"
  else
    # ── agent_hallucinations ─────────────────────────────────────────────────
    local _ah_out _ah_rc
    _ah_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT agent_name, COUNT(*) FROM agent_hallucinations \
       WHERE timestamp >= datetime('now','-7 days') \
       GROUP BY agent_name ORDER BY COUNT(*) DESC;" 2>&1)"
    _ah_rc=$?
    if echo "$_ah_out" | grep -qi "no such table"; then
      printf "%b honesty: agent_hallucinations — no data yet\n" "$INFO"
    elif [ $_ah_rc -ne 0 ]; then
      printf "%b honesty: agent_hallucinations — unavailable (db query failed)\n" "$INFO"
    elif [ -z "$_ah_out" ]; then
      printf "%b honesty: agent_hallucinations — none in last 7d\n" "$OK"
    else
      local _ah_total=0
      while IFS='|' read -r _ag _cnt; do
        [ -z "$_ag" ] && continue
        _ah_total=$((_ah_total + _cnt))
      done <<< "$_ah_out"
      printf "%b honesty: agent_hallucinations — %d flagged\n" "$WARN" "$_ah_total"
      while IFS='|' read -r _ag _cnt; do
        [ -z "$_ag" ] && continue
        printf "    %-20s %d claim(s)\n" "$_ag" "$_cnt"
      done <<< "$_ah_out"
    fi

    # ── completeness_events ──────────────────────────────────────────────────
    local _ce_out _ce_rc
    _ce_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT severity, COUNT(*) FROM completeness_events \
       WHERE truncated_at >= datetime('now','-7 days') \
       GROUP BY severity ORDER BY COUNT(*) DESC;" 2>&1)"
    _ce_rc=$?
    if echo "$_ce_out" | grep -qi "no such table"; then
      printf "%b honesty: completeness_events — no data yet\n" "$INFO"
    elif [ $_ce_rc -ne 0 ]; then
      printf "%b honesty: completeness_events — unavailable (db query failed)\n" "$INFO"
    elif [ -z "$_ce_out" ]; then
      printf "%b honesty: completeness_events — none in last 7d\n" "$OK"
    else
      local _ce_total=0
      while IFS='|' read -r _sev _cnt; do
        [ -z "$_sev" ] && continue
        _ce_total=$((_ce_total + _cnt))
      done <<< "$_ce_out"
      printf "%b honesty: completeness_events — %d flagged\n" "$WARN" "$_ce_total"
      while IFS='|' read -r _sev _cnt; do
        [ -z "$_sev" ] && continue
        printf "    %-8s %d event(s)\n" "$_sev" "$_cnt"
      done <<< "$_ce_out"
    fi

    # ── agent_protocol_violations ────────────────────────────────────────────
    local _apv_out _apv_rc
    _apv_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT COALESCE(agent_type,'unknown'), COUNT(*) FROM agent_protocol_violations \
       WHERE timestamp >= datetime('now','-7 days') \
       GROUP BY agent_type ORDER BY COUNT(*) DESC;" 2>&1)"
    _apv_rc=$?
    if echo "$_apv_out" | grep -qi "no such table"; then
      printf "%b honesty: agent_protocol_violations — no data yet\n" "$INFO"
    elif [ $_apv_rc -ne 0 ]; then
      printf "%b honesty: agent_protocol_violations — unavailable (db query failed)\n" "$INFO"
    elif [ -z "$_apv_out" ]; then
      printf "%b honesty: agent_protocol_violations — none in last 7d\n" "$OK"
    else
      local _apv_total=0
      while IFS='|' read -r _at _cnt; do
        [ -z "$_at" ] && continue
        _apv_total=$((_apv_total + _cnt))
      done <<< "$_apv_out"
      printf "%b honesty: agent_protocol_violations — %d flagged\n" "$WARN" "$_apv_total"
      while IFS='|' read -r _at _cnt; do
        [ -z "$_at" ] && continue
        printf "    %-20s %d violation(s)\n" "$_at" "$_cnt"
      done <<< "$_apv_out"
    fi

    # ── code_ref_checks ──────────────────────────────────────────────────────
    local _crc_out _crc_rc
    _crc_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT COUNT(*) FROM code_ref_checks \
       WHERE verified=0 AND timestamp >= datetime('now','-7 days');" 2>&1)"
    _crc_rc=$?
    if echo "$_crc_out" | grep -qi "no such table"; then
      printf "%b honesty: code_ref_checks — no data yet\n" "$INFO"
    elif [ $_crc_rc -ne 0 ]; then
      printf "%b honesty: code_ref_checks — unavailable (db query failed)\n" "$INFO"
    elif [ -z "$_crc_out" ] || [ "$_crc_out" -eq 0 ] 2>/dev/null; then
      printf "%b honesty: code_ref_checks — none in last 7d\n" "$OK"
    else
      printf "%b honesty: code_ref_checks — %d unverified ref(s)\n" "$WARN" "$_crc_out"
    fi

    # ── silent truncations (maxTurns) ────────────────────────────────────────
    # Detects agent_runs rows that were silently cut off by the maxTurns cap:
    #   - stuck running > 2h (pre-reaper, not yet abandoned)
    #   - status='abandoned' in the last 7d (reaped by cast-abandon-stale-runs.py)
    # Note: abandoned_at column is added by the reaper on first run; if it is
    # absent the UNION query fails and we degrade gracefully via the rc-ne-0 branch.
    local _st_out _st_rc
    _st_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT COALESCE(agent,'unknown'), COUNT(*) FROM agent_runs \
       WHERE (status='running' AND started_at < datetime('now','-2 hours')) \
          OR (status='abandoned' AND abandoned_at >= datetime('now','-7 days')) \
       GROUP BY agent ORDER BY COUNT(*) DESC;" 2>&1)"
    _st_rc=$?
    if echo "$_st_out" | grep -qi "no such table"; then
      printf "%b honesty: silent truncations (maxTurns) — no data yet\n" "$INFO"
    elif [ "$_st_rc" -ne 0 ]; then
      printf "%b honesty: silent truncations (maxTurns) — unavailable (db query failed)\n" "$INFO"
    elif [ -z "$_st_out" ]; then
      printf "%b honesty: silent truncations (maxTurns) — none in last 7d\n" "$OK"
    else
      local _st_total=0
      while IFS='|' read -r _ag _cnt; do
        [ -z "$_ag" ] && continue
        _st_total=$((_st_total + _cnt))
      done <<< "$_st_out"
      printf "%b honesty: silent truncations (maxTurns) — %d suspected truncation(s)\n" "$WARN" "$_st_total"
      while IFS='|' read -r _ag _cnt; do
        [ -z "$_ag" ] && continue
        printf "    %-20s %d\n" "$_ag" "$_cnt"
      done <<< "$_st_out"
      printf "    likely maxTurns cap hit — agent stopped without Status; see rules working-conventions 'Agent Turn Limits'\n"
    fi

    # ── spend-consistency ────────────────────────────────────────────────────
    # Runs both the LIKE-based query (cast-budget-alert.sh behavior) and the
    # normalized DATE-based query (cast budget / cast-dash.py behavior) and
    # flags when they diverge > $0.01 — the root cause of the 2026-06-11
    # incident where cast budget reported $0 while the hard-limit fired $375.83.
    # Honest degradation: absent table or column → INFO, never ERR.
    local _sc_out _sc_rc
    _sc_out="$(python3 - "$CAST_DB_PATH" <<'PYEOF'
import sqlite3, sys, datetime
from datetime import timezone

db = sys.argv[1]
today = datetime.datetime.now(timezone.utc).strftime('%Y-%m-%d')

try:
    conn = sqlite3.connect(db, timeout=5)
    conn.row_factory = sqlite3.Row
    # LIKE-based (matches cast-budget-alert.sh)
    like_row = conn.execute(
        "SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs WHERE started_at LIKE ? || '%'",
        (today,)
    ).fetchone()
    like_spend = float(like_row[0]) if like_row else 0.0
    # Normalized DATE-based (matches fixed cast budget query)
    date_row = conn.execute(
        "SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs "
        "WHERE date(replace(replace(started_at,'T',' '),'Z',''))=?",
        (today,)
    ).fetchone()
    date_spend = float(date_row[0]) if date_row else 0.0
    conn.close()
    if like_spend == 0.0 and date_spend == 0.0:
        print("INFO:no cost data today")
    elif abs(like_spend - date_spend) > 0.01:
        print("WARN:LIKE=${:.4f} DATE=${:.4f}".format(like_spend, date_spend))
    else:
        print("OK:{:.4f}".format(like_spend))
except sqlite3.OperationalError as e:
    err = str(e).lower()
    if 'no such table' in err or 'no such column' in err:
        print("INFO:agent_runs table or cost_usd column not available")
    else:
        print("INFO:db query failed ({})".format(e))
except Exception as e:
    print("INFO:unavailable ({})".format(e))
PYEOF
    2>&1)"
    _sc_rc=$?
    if [ $_sc_rc -ne 0 ] || echo "$_sc_out" | grep -qi "traceback"; then
      printf "%b spend-consistency: check failed (python3 error)\n" "$INFO"
    elif echo "$_sc_out" | grep -q "^INFO:"; then
      _sc_msg="${_sc_out#INFO:}"
      printf "%b spend-consistency: %s\n" "$INFO" "$_sc_msg"
    elif echo "$_sc_out" | grep -q "^WARN:"; then
      _sc_msg="${_sc_out#WARN:}"
      printf "%b spend-consistency: %s — mismatch >$0.01 (timestamp format divergence)\n" "$WARN" "$_sc_msg"
      overall_ok=0
    elif echo "$_sc_out" | grep -q "^OK:"; then
      _sc_msg="${_sc_out#OK:}"
      printf "%b spend-consistency: \$%s (LIKE ≈ DATE, within \$0.01)\n" "$OK" "$_sc_msg"
    else
      printf "%b spend-consistency: unexpected output — %s\n" "$INFO" "$_sc_out"
    fi

    # ── crashed sessions ─────────────────────────────────────────────────────
    # cast-abandon-stale-runs.py writes status='crashed' but doctor never reads
    # it. Surface here alongside the abandoned/truncation block.
    # Use started_at (live schema: id, project, project_root, started_at,
    # ended_at, status, deleted_at — no updated_at column exists).
    # apply replace() normalization: started_at is ISO-8601 T/Z form while
    # datetime('now','-7 days') returns space-separated form — lexicographic
    # comparison of mixed separators is unreliable at the sub-day boundary.
    local _cs_out _cs_rc
    _cs_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT COALESCE(COUNT(*),0) FROM sessions \
       WHERE status='crashed' \
         AND replace(replace(started_at,'T',' '),'Z','') >= datetime('now','-7 days');" 2>&1)"
    _cs_rc=$?
    # Threshold: CAST_CRASH_WARN_THRESHOLD (default 100 per 7d).
    # Background: sessions killed without a clean exit (terminal kill, hung agent,
    # bats hang) accumulate as bookkeeping crashes — cast-session-end.sh:231 writes
    # ended_at only on clean exit. Data-calibrated 2026-06-11: observed ~89/7d at
    # current CAST usage (20x Max, heavy agent work); 100 filters noise while still
    # catching genuine crash spikes. Override via CAST_CRASH_WARN_THRESHOLD env var.
    # See docs/crashed-sessions-analysis-2026-06-11.md for full rationale.
    _cs_threshold="${CAST_CRASH_WARN_THRESHOLD:-100}"
    if echo "$_cs_out" | grep -qi "no such table\|no such column"; then
      printf "%b crashed-sessions: sessions table not queryable\n" "$INFO"
    elif [ $_cs_rc -ne 0 ]; then
      printf "%b crashed-sessions: unavailable (db query failed)\n" "$INFO"
    elif [ "${_cs_out:-0}" -gt "${_cs_threshold}" ] 2>/dev/null; then
      printf "%b crashed-sessions: %s session(s) crashed in last 7d (threshold %s) — check ~/.claude/logs/\n" "$WARN" "$_cs_out" "$_cs_threshold"
      overall_ok=0
    else
      printf "%b crashed-sessions: %s in last 7d (below threshold %s)\n" "$OK" "${_cs_out:-0}" "$_cs_threshold"
    fi
  fi

  # 14. Updates Available
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  printf "${C_BOLD}Updates Available${C_RESET}\n"
  _doctor_upgrades

  # 15. Agent frontmatter parses
  local frontmatter_errors
  frontmatter_errors="$(python3 - "$CAST_AGENTS_DIR" <<'PYEOF'
import os, sys, re
agents_dir = sys.argv[1]
errors = []
if os.path.isdir(agents_dir):
    for fname in sorted(os.listdir(agents_dir)):
        if not fname.endswith('.md'):
            continue
        # Skip non-agent docs that ride along in agents/ (conventions files,
        # READMEs). Agent files are kebab-case lowercase by convention.
        if not fname[0].islower():
            continue
        fpath = os.path.join(agents_dir, fname)
        try:
            with open(fpath) as fh:
                content = fh.read()
            # Expect frontmatter block bounded by '---' at top
            m = re.match(r'^---\s*\n(.*?)\n---\s*\n', content, re.DOTALL)
            if not m:
                errors.append(f"{fname}: no frontmatter block")
                continue
            block = m.group(1)
            # Cheap key check (no yaml lib in stdlib)
            for key in ('name', 'description', 'tools', 'model'):
                if not re.search(rf'^{key}\s*:', block, re.MULTILINE):
                    errors.append(f"{fname}: missing '{key}'")
        except Exception as e:
            errors.append(f"{fname}: {e}")
for e in errors:
    print(e)
PYEOF
2>/dev/null || true)"
  if [ -z "$frontmatter_errors" ]; then
    printf "%b Agent frontmatter: all %d pass native format check\n" "$OK" "$agent_count"
  else
    printf "%b Agent frontmatter: errors found:\n" "$WARN"
    while IFS= read -r line; do
      [ -n "$line" ] && printf "    %s\n" "$line"
    done <<< "$frontmatter_errors"
    overall_ok=0
  fi

  # 16. MCP servers reachable (best-effort)
  local settings_file="${HOME}/.claude/settings.json"
  if [ -f "$settings_file" ]; then
    local mcp_status
    mcp_status="$(python3 - "$settings_file" <<'PYEOF'
import json, sys, os, shutil, subprocess
try:
    with open(sys.argv[1]) as f:
        cfg = json.load(f)
    servers = cfg.get("mcpServers", {})
except Exception:
    sys.exit(0)
for name, server in servers.items():
    url = server.get("url")
    cmd = server.get("command")
    if url:
        try:
            r = subprocess.run(["curl", "-sf", "--max-time", "2", url], capture_output=True, timeout=3)
            status = "ok" if r.returncode == 0 else "unreachable"
        except Exception:
            status = "error"
        print(f"{name}|{status}|{url}")
    elif cmd:
        resolved = shutil.which(cmd) or (cmd if os.path.isfile(cmd) else None)
        status = "ok" if resolved else "missing"
        print(f"{name}|{status}|{cmd}")
    else:
        print(f"{name}|unknown|<no url or command>")
PYEOF
  2>/dev/null || echo "")"
    if [ -z "$mcp_status" ]; then
      printf "%b MCP servers: none configured\n" "$INFO"
    else
      local mcp_ok=0 mcp_bad=0
      while IFS='|' read -r name status target; do
        [ -z "$name" ] && continue
        if [ "$status" = "ok" ]; then
          mcp_ok=$((mcp_ok+1))
        else
          mcp_bad=$((mcp_bad+1))
        fi
      done <<< "$mcp_status"
      if [ "$mcp_bad" -eq 0 ]; then
        printf "%b MCP servers: %d configured, all reachable\n" "$OK" "$mcp_ok"
      else
        printf "%b MCP servers: %d reachable, %d unreachable/missing\n" "$WARN" "$mcp_ok" "$mcp_bad"
        while IFS='|' read -r name status target; do
          [ -z "$name" ] && continue
          [ "$status" = "ok" ] && continue
          printf "    %s: %s (%s)\n" "$name" "$status" "$target"
        done <<< "$mcp_status"
      fi
    fi
  else
    printf "%b MCP servers: settings.json not found\n" "$INFO"
  fi

  # 17. Routines validate
  local routines_dir="${CAST_REPO_DIR}/routines"
  if [ -d "$routines_dir" ]; then
    local routine_status
    routine_status="$(python3 - "$routines_dir" <<'PYEOF'
import os, sys, re
routines_dir = sys.argv[1]
total = 0
errors = []
for fname in sorted(os.listdir(routines_dir)):
    if not fname.endswith('.yaml') and not fname.endswith('.yml'):
        continue
    total += 1
    fpath = os.path.join(routines_dir, fname)
    try:
        with open(fpath) as fh:
            content = fh.read()
        for key in ('name:', 'agent:', 'prompt_template:'):
            if key not in content:
                errors.append(f"{fname}: missing '{key.rstrip(':')}'")
    except Exception as e:
        errors.append(f"{fname}: {e}")
print(f"total={total}")
for e in errors:
    print(f"err={e}")
PYEOF
  2>/dev/null || echo "total=0")"
    local rt_total=0
    local rt_errs=0
    while IFS= read -r line; do
      case "$line" in
        total=*) rt_total="${line#total=}" ;;
        err=*) rt_errs=$((rt_errs+1)) ;;
      esac
    done <<< "$routine_status"
    if [ "$rt_errs" -eq 0 ]; then
      if [ "$rt_total" -eq 0 ]; then
        printf "%b Routines: none configured\n" "$INFO"
      else
        printf "%b Routines: %d configured, all schemas valid\n" "$OK" "$rt_total"
      fi
    else
      printf "%b Routines: %d configured, %d with schema errors\n" "$WARN" "$rt_total" "$rt_errs"
      while IFS= read -r line; do
        case "$line" in err=*) printf "    %s\n" "${line#err=}" ;; esac
      done <<< "$routine_status"
      overall_ok=0
    fi
  else
    printf "%b Routines: directory not found (%s)\n" "$INFO" "$routines_dir"
  fi

  # 18. Backup freshness
  local backup_root
  backup_root="${CAST_BACKUP_ROOT:-${HOME}/Library/Application Support/cast/backups}"
  local backup_max_age_hours="${CAST_BACKUP_MAX_AGE_HOURS:-48}"
  local newest_snapshot=""
  if [[ -d "$backup_root" ]]; then
    newest_snapshot="$(ls -dt "${backup_root}"/cast-snapshot-* 2>/dev/null | head -1)"
  fi
  if [[ -z "$newest_snapshot" ]]; then
    printf "%b Backups: no snapshot found in %s\n" "$WARN" "$backup_root"
    overall_ok=0
  else
    local snap_age_hours
    snap_age_hours="$(python3 -c 'import os,sys,time
try:
    print(int((time.time()-os.path.getmtime(sys.argv[1]))//3600))
except Exception:
    print(9999)' "$newest_snapshot" 2>/dev/null || echo 9999)"
    if [[ "${snap_age_hours:-9999}" -lt "${backup_max_age_hours}" ]]; then
      printf "%b Backups: snapshot %s (%sh old)\n" "$OK" "$(basename "$newest_snapshot")" "$snap_age_hours"
    else
      printf "%b Backups: newest snapshot is %sh old (threshold: %sh) — run \`cast backup\`\n" \
        "$WARN" "$snap_age_hours" "$backup_max_age_hours"
      overall_ok=0
    fi
  fi

  # Litestream replica freshness (opt-in continuous replication outside blast radius)
  local _ls_root="${CAST_LITESTREAM_ROOT:-${HOME}/Library/Application Support/cast}"
  local _ls_config="${_ls_root}/litestream.yml"
  local _ls_replica="${_ls_root}/litestream/cast-db"
  if ! command -v litestream >/dev/null 2>&1; then
    printf "%b Litestream: not installed (opt-in — brew install benbjohnson/litestream/litestream)\n" "$INFO"
  elif [[ ! -f "$_ls_config" ]]; then
    printf "%b Litestream: installed but config missing — run: bash scripts/cast-litestream-setup.sh\n" "$WARN"
  else
    # Daemon status — macOS-only via launchctl; degrade gracefully on Linux/CI
    local _daemon_state="unknown"
    if command -v launchctl >/dev/null 2>&1; then
      if launchctl list com.cast.litestream >/dev/null 2>&1; then
        _daemon_state="loaded"
      else
        _daemon_state="not_loaded"
        printf "%b Litestream: daemon not loaded (check ~/Library/LaunchAgents/com.cast.litestream.plist)\n" "$WARN"
      fi
    else
      printf "%b Litestream: daemon check skipped (launchctl not available)\n" "$INFO"
    fi
    # Replica directory presence + freshness
    # Use find to exclude hidden files (.DS_Store etc) when probing for real content
    local _has_real_files
    _has_real_files="$(find "$_ls_replica" -type f ! -name '.*' -print -quit 2>/dev/null || true)"
    if [[ ! -d "$_ls_replica" ]] || [[ -z "$_has_real_files" ]]; then
      printf "%b Litestream: replica dir missing or empty (%s)\n" "$WARN" "$_ls_replica"
    else
      local _ls_lag_s="-1"
      _ls_lag_s="$(python3 - "$_ls_replica" "$CAST_DB_PATH" <<'PYEOF'
import os, sys
replica_dir = sys.argv[1]
db_path = sys.argv[2]
try:
    newest = max(
        (os.path.getmtime(os.path.join(root, fn))
         for root, _dirs, files in os.walk(replica_dir)
         for fn in files
         if not fn.startswith('.')),
        default=None
    )
    if newest is None:
        print(-1)
        sys.exit(0)
    db_mtime = os.path.getmtime(db_path) if os.path.exists(db_path) else newest
    lag = int(db_mtime - newest)
    print(max(lag, 0))
except Exception:
    print(-1)
PYEOF
      2>/dev/null || echo -1)"
      if [[ "${_ls_lag_s}" -lt 0 ]]; then
        printf "%b Litestream: could not determine replica age\n" "$WARN"
      elif [[ "${_ls_lag_s}" -gt 3600 ]]; then
        printf "%b Litestream: replica stale — lag %ds (>1h behind cast.db)\n" "$WARN" "${_ls_lag_s}"
      else
        # Fresh replica — output depends on daemon state
        if [[ "$_daemon_state" == "not_loaded" ]]; then
          printf "%b Litestream: replica present (lag %ds) but daemon not loaded — replication will go stale\n" "$WARN" "${_ls_lag_s}"
        else
          # loaded or unknown — freshness evidence is sufficient for OK
          printf "%b Litestream: replica fresh (lag %ds)\n" "$OK" "${_ls_lag_s}"
        fi
      fi
    fi
  fi

  # 19. Stale cast-swarm-* branch count early-warning
  local swarm_branch_warn_threshold=25
  local swarm_branch_count=0
  if git -C "${CAST_REPO_DIR:-$HOME/.claude}" branch --list 'cast-swarm-*' >/dev/null 2>&1; then
    swarm_branch_count="$(git -C "${CAST_REPO_DIR:-$HOME/.claude}" branch --list 'cast-swarm-*' 2>/dev/null | wc -l | tr -d ' ')"
  fi
  if [[ "${swarm_branch_count:-0}" -gt "$swarm_branch_warn_threshold" ]]; then
    printf "%b cast-swarm-* branches: %d (exceeds threshold of %d) — run \`cast clean --apply\` or set CAST_GROOM_AUTO_APPLY=1\n" \
      "$WARN" "$swarm_branch_count" "$swarm_branch_warn_threshold"
  else
    printf "%b cast-swarm-* branches: %d\n" "$INFO" "${swarm_branch_count:-0}"
  fi

  # 20. Homebrew tap count vs packages constant advisory
  # CAST taps = homebrew-cast* (12) + homebrew-claudes-journal (1) = 13
  # Excludes dropped non-CAST taps: homebrew-engram, homebrew-stratum, homebrew-jarvis
  local expected_packages=13  # keep in sync with cast_stat_packages in scripts/cast-stats-lib.sh
  if command -v gh >/dev/null 2>&1; then
    local live_packages
    live_packages="$(gh repo list ek33450505 --no-archived --limit 200 --json name -q '[.[].name | select(startswith("homebrew-cast") or . == "homebrew-claudes-journal")] | length' 2>/dev/null || echo "")"
    if [[ "$live_packages" =~ ^[0-9]+$ ]] && [[ "$live_packages" -gt 0 ]]; then
      if [[ "$live_packages" -eq "$expected_packages" ]]; then
        printf "%b Homebrew taps: live=%d matches constant=%d\n" "$OK" "$live_packages" "$expected_packages"
      else
        printf "%b Homebrew taps: live=%d but constant=%d — update CAST_PACKAGES_COUNT / cast-stats-lib.sh\n" \
          "$WARN" "$live_packages" "$expected_packages"
      fi
    else
      printf "%b Homebrew taps: gh query returned no count — skipping advisory\n" "$INFO"
    fi
  else
    printf "%b Homebrew taps: gh not available — skipping advisory\n" "$INFO"
  fi

  # 21. Tool-call failures (last 7d) — collected-but-read surface
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  printf "${C_BOLD}Tool-call failures (last 7d)${C_RESET}\n"
  if ! command -v sqlite3 >/dev/null 2>&1; then
    printf "%b tool_call_failures: cast.db unavailable (sqlite3 not found)\n" "$INFO"
  else
    local _tcf_count_out _tcf_count_rc
    _tcf_count_out="$(sqlite3 "$CAST_DB_PATH" \
      "SELECT COUNT(*) FROM tool_call_failures \
       WHERE timestamp >= datetime('now','-7 days');" 2>&1)"
    _tcf_count_rc=$?
    if echo "$_tcf_count_out" | grep -qi "no such table"; then
      printf "%b tool_call_failures: table absent — no data yet\n" "$INFO"
    elif [ $_tcf_count_rc -ne 0 ]; then
      printf "%b tool_call_failures: unavailable (db query failed)\n" "$INFO"
    else
      local _tcf_count="${_tcf_count_out:-0}"
      local _tcf_recent_out
      _tcf_recent_out="$(sqlite3 "$CAST_DB_PATH" \
        "SELECT tool_name, error, timestamp \
         FROM tool_call_failures \
         ORDER BY timestamp DESC LIMIT 1;" 2>/dev/null || true)"
      if [ "${_tcf_count:-0}" -eq 0 ]; then
        printf "%b tool_call_failures: no failures in last 7d\n" "$INFO"
      else
        if [[ -n "$_tcf_recent_out" ]]; then
          local _tcf_tool _tcf_err _tcf_ts
          IFS='|' read -r _tcf_tool _tcf_err _tcf_ts <<< "$_tcf_recent_out"
          # Truncate error to first 80 chars
          _tcf_err="${_tcf_err:0:80}"
          printf "%b tool_call_failures (last 7d): %d  ·  most recent: %s — %s (%s)\n" \
            "$WARN" "$_tcf_count" "$_tcf_tool" "$_tcf_err" "$_tcf_ts"
        else
          printf "%b tool_call_failures (last 7d): %d\n" "$WARN" "$_tcf_count"
        fi
      fi
    fi
  fi

  # 22. DB-contract ratchet advisory
  # Prefer repo version of the script: its REPO_ROOT resolves correctly for the baseline
  # and cast-db-init.sh. Run without --db so the check is fast and read-only.
  local _dbc_script="${CAST_REPO_DIR}/scripts/cast-db-contract.py"
  if [ ! -f "$_dbc_script" ]; then
    _dbc_script="${CAST_SCRIPTS_DIR}/cast-db-contract.py"
  fi
  if [ ! -f "$_dbc_script" ]; then
    printf "%b db-contract: unavailable (cast-db-contract.py not found — run: bash install.sh)\n" "$INFO"
  else
    local _dbc_out _dbc_rc
    # Capture both stdout and stderr; UNCHECKED desktop/DB degradation (WARN/INFO to stderr) is expected.
    _dbc_out="$(python3 "$_dbc_script" --check 2>&1)"
    _dbc_rc=$?
    if [ "$_dbc_rc" -eq 0 ]; then
      # Baseline clean — show counts from baseline file
      local _dbc_baseline="${CAST_REPO_DIR}/.github/db-contract-baseline.json"
      local _dbc_contra_count=0 _dbc_drop_count=0
      if [ -f "$_dbc_baseline" ] && command -v python3 >/dev/null 2>&1; then
        local _dbc_counts_out
        _dbc_counts_out="$(python3 - "$_dbc_baseline" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(len(d.get('contradictions', [])), len(d.get('safe_drop_candidates', [])))
except Exception:
    print(0, 0)
PYEOF
        2>/dev/null || echo "0 0")"
        read -r _dbc_contra_count _dbc_drop_count <<< "$_dbc_counts_out"
      fi
      printf "%b db-contract: %d baselined contradictions, %d safe-drop candidates, 0 new\n" \
        "$OK" "${_dbc_contra_count:-0}" "${_dbc_drop_count:-0}"
    elif [ "$_dbc_rc" -eq 1 ]; then
      printf "%b db-contract: new schema-contract violations detected\n" "$WARN"
      echo "$_dbc_out" | grep -E "CONTRADICTION|SAFE-DROP-CANDIDATE" | while IFS= read -r _dbc_line; do
        [ -z "$_dbc_line" ] && continue
        printf "    %s\n" "$_dbc_line"
      done
      printf "    Fix: python3 scripts/cast-db-contract.py --update-baseline\n"
      overall_ok=0
    else
      printf "%b db-contract: unavailable (script error — rc=%d)\n" "$INFO" "$_dbc_rc"
    fi
  fi

  # Summary
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  if [ "$overall_ok" -eq 1 ]; then
    printf "%b All checks passed\n" "$OK"
  else
    printf "%b Some checks need attention\n" "$WARN"
  fi
}

# ── Doctor helper: upgrades block ────────────────────────────────────────────
_doctor_upgrades() {
  local CAST_STATE_DIR="${HOME}/.claude/cast"
  local candidates_file="${CAST_STATE_DIR}/upgrade-candidates.json"
  local last_checked_file="${CAST_STATE_DIR}/last-checked-upgrades.json"
  local INFO_SYM="[${C_CYAN}--${C_RESET}]"
  local UP_SYM="[${C_YELLOW}^^${C_RESET}]"
  local OK_SYM="[${C_GREEN}ok${C_RESET}]"

  # Check gh availability first
  if ! command -v gh >/dev/null 2>&1; then
    printf "  %b gh CLI not installed — install gh to enable update notifications.\n" "$INFO_SYM"
    return 0
  fi

  # Check if candidates file exists and is fresh (<24h old)
  local file_exists=0
  local file_fresh=0
  if [ -f "$candidates_file" ]; then
    file_exists=1
    local file_age_hours
    file_age_hours="$(python3 -c "
import os, time
try:
    mtime = os.path.getmtime('$candidates_file')
    age_s = time.time() - mtime
    print(int(age_s // 3600))
except Exception:
    print(999)
" 2>/dev/null || echo 999)"
    if [ "${file_age_hours:-999}" -lt 24 ]; then
      file_fresh=1
    fi
  fi

  if [ "$file_exists" -eq 0 ] || [ "$file_fresh" -eq 0 ]; then
    printf "  %b Run \`cast upgrade-check\` to check for new releases (last check >24h ago or never run).\n" "$INFO_SYM"
    return 0
  fi

  # Read last-checked timestamp for display
  local last_checked_display="unknown"
  if [ -f "$last_checked_file" ]; then
    last_checked_display="$(python3 -c "
import json
try:
    d = json.load(open('$last_checked_file'))
    print(d.get('last_checked', 'unknown'))
except Exception:
    print('unknown')
" 2>/dev/null || echo "unknown")"
  fi
  printf "  %b Last checked: %s\n" "$INFO_SYM" "$last_checked_display"

  # Parse and display candidates
  python3 - "$candidates_file" <<'PYEOF'
import sys, json, os

candidates_file = sys.argv[1]
try:
    with open(candidates_file) as f:
        candidates = json.load(f)
except Exception:
    candidates = {}

# Group by repo+tag to find distinct upgrade opportunities
upgrades = {}
for key, entry in candidates.items():
    repo = entry.get('repo', '')
    tag = entry.get('tag', '')
    category = entry.get('category', 'SKIP')
    if category == 'SKIP':
        continue
    rkey = f"{repo}@{tag}"
    if rkey not in upgrades:
        upgrades[rkey] = {'repo': repo, 'tag': tag, 'category': category, 'items': []}
    upgrades[rkey]['items'].append(entry.get('item', ''))

if not upgrades:
    print("  [ok] No new upgrade candidates found.")
else:
    for rkey, u in sorted(upgrades.items()):
        repo = u['repo']
        tag = u['tag']
        item_count = len(u['items'])
        cat = u['category']
        marker = "^^" if cat == "CRITICAL" else " ^"
        print(f"  [{marker}] {repo}: {tag} available — {item_count} item(s) — run `cast upgrade-check` for details")
PYEOF

  printf "  %b Run \`cast upgrade-check\` to refresh.\n" "$INFO_SYM"
}

# ── Subcommand: backup ───────────────────────────────────────────────────────
_cmd_backup() {
  local do_overlay=0
  for arg in "$@"; do
    case "$arg" in
      --overlay) do_overlay=1 ;;
      --help|-h)
        printf "Usage: cast backup [--overlay]\n"
        printf "  Run on-disk snapshot via cast-snapshot.py.\n"
        printf "  --overlay  Also sync to GitHub overlay repo (or set CAST_OVERLAY_SYNC=1).\n"
        return 0
        ;;
    esac
  done
  [[ "${CAST_OVERLAY_SYNC:-0}" == "1" ]] && do_overlay=1

  local snapshot_script="${CAST_SCRIPTS_DIR}/cast-snapshot.py"
  if [[ ! -f "$snapshot_script" ]]; then
    snapshot_script="${CAST_REPO_DIR}/scripts/cast-snapshot.py"
  fi
  if [[ ! -f "$snapshot_script" ]]; then
    _error "cast-snapshot.py not found. Run: bash install.sh"
    return 1
  fi

  printf "${C_BOLD}Running cast backup...${C_RESET}\n"
  local snap_output
  if snap_output="$(python3 "$snapshot_script" 2>/dev/null)"; then
    python3 -m json.tool <<< "$snap_output" 2>/dev/null || printf "%s\n" "$snap_output"
    printf "${C_GREEN}Snapshot complete.${C_RESET}\n"
  else
    printf "${C_RED}Snapshot failed.${C_RESET}\n"
    return 1
  fi

  if [[ "$do_overlay" -eq 1 ]]; then
    local overlay_script="${CAST_SCRIPTS_DIR}/cast-overlay-sync.sh"
    if [[ ! -f "$overlay_script" ]]; then
      overlay_script="${CAST_REPO_DIR}/scripts/cast-overlay-sync.sh"
    fi
    if [[ ! -f "$overlay_script" ]]; then
      printf "${C_YELLOW}[!!] cast-overlay-sync.sh not found — skipping overlay push.${C_RESET}\n"
    else
      printf "${C_BOLD}Running overlay sync...${C_RESET}\n"
      if bash "$overlay_script"; then
        printf "${C_GREEN}Overlay sync complete.${C_RESET}\n"
      else
        printf "${C_YELLOW}[!!] Overlay sync failed — on-disk snapshot was successful.${C_RESET}\n"
      fi
    fi
  fi
}

# ── Subcommand: upgrade-check ────────────────────────────────────────────────
_cmd_upgrade_check() {
  local upgrade_script="${CAST_SCRIPTS_DIR}/cast-upgrade-check.sh"
  if [ ! -f "$upgrade_script" ]; then
    upgrade_script="${CAST_REPO_DIR}/scripts/cast-upgrade-check.sh"
  fi
  if [ ! -f "$upgrade_script" ]; then
    _error "cast-upgrade-check.sh not found. Run: bash install.sh"
    return 1
  fi

  bash "$upgrade_script" "$@"
  local exit_code=$?
  if [ "$exit_code" -eq 0 ]; then
    _success "upgrade-check complete — run \`cast doctor\` to see results"
  fi
  return "$exit_code"
}

# ── Subcommand: migrate ──────────────────────────────────────────────────────
_cmd_migrate() {
  local dry_run_flag=""

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --dry-run)  dry_run_flag="--dry-run"; shift ;;
      --help|-h)
        cat <<USAGE
Usage: cast migrate [--dry-run]

Apply pending versioned SQL migrations to cast.db.
Migrations live in scripts/migrations/NNN_name.sql and are applied in order.
Running multiple times is safe (already-applied migrations are skipped).

Options:
  --dry-run   Show pending migrations without applying them
USAGE
        return 0
        ;;
      *) shift ;;
    esac
  done

  # Resolve migrate script: installed copy first, repo fallback
  local migrate_script="${CAST_SCRIPTS_DIR}/cast-migrate.py"
  if [ ! -f "$migrate_script" ]; then
    migrate_script="${CAST_REPO_DIR}/scripts/cast-migrate.py"
  fi
  if [ ! -f "$migrate_script" ]; then
    _error "cast-migrate.py not found. Run: bash install.sh"
    return 1
  fi

  if [ -n "$dry_run_flag" ]; then
    python3 "$migrate_script" --dry-run
  else
    python3 "$migrate_script" --confirm
  fi
}

# ── Subcommand: exec ─────────────────────────────────────────────────────────
_cmd_exec() {
  local mode_flag=""
  local plan_file=""

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --resume) mode_flag="--resume"; shift ;;
      --status) mode_flag="--status"; shift ;;
      --help|-h)
        cat <<USAGE
Usage: cast exec [--resume | --status] <plan-file>

  <plan-file>            Execute all batches defined in the plan manifest
  --resume <plan-file>   Skip completed batches, resume from first non-complete
  --status <plan-file>   Print current checkpoint state and exit
USAGE
        return 0
        ;;
      -*)
        _error "Unknown flag: $1"
        return 1
        ;;
      *)
        if [ -z "$plan_file" ]; then
          plan_file="$1"
        else
          _error "Unexpected argument: $1"
          return 1
        fi
        shift
        ;;
    esac
  done

  if [ -z "$plan_file" ]; then
    _error "Plan file is required."
    printf "  Usage: cast exec [--resume|--status] <plan-file>\n" >&2
    return 1
  fi

  local exec_script="${CAST_SCRIPTS_DIR}/cast-exec.sh"
  if [ ! -f "$exec_script" ]; then
    exec_script="${CAST_REPO_DIR}/scripts/cast-exec.sh"
  fi
  if [ ! -f "$exec_script" ]; then
    _error "cast-exec.sh not found"
    return 1
  fi

  if [ -n "$mode_flag" ]; then
    bash "$exec_script" "$mode_flag" "$plan_file"
  else
    bash "$exec_script" "$plan_file"
  fi
}

# ── Subcommand: tidy ────────────────────────────────────────────────────────
_cmd_tidy() {
  local dry_run=0

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --dry-run)  dry_run=1; shift ;;
      --help|-h)
        cat <<USAGE
Usage: cast tidy [--dry-run]

Clean up accumulated CAST files:
  Plans older than 7 days       → archived to plans/archive/YYYY-MM/
  Events older than 3 days      → deleted
  Logs older than 7 days / >1MB → rotated (max 4 rotations)
  cast.db agent_runs >30 days   → pruned + VACUUM
  Briefings older than 14 days  → archived to briefings/archive/YYYY-MM/
  Agent status older than 24h   → deleted
  Orchestrator checkpoints >7d  → deleted
  Stale worktree metadata        → pruned (git worktree prune)

Options:
  --dry-run   Preview what would be cleaned without making changes
USAGE
        return 0
        ;;
      *) shift ;;
    esac
  done

  local label="Cleaning"
  [ "$dry_run" -eq 1 ] && label="Dry run"

  printf "${C_BOLD}CAST Tidy${C_RESET} (%s)\n" "$label"
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"

  local plans_archived=0 events_deleted=0 logs_rotated=0 db_pruned=0
  local briefings_archived=0 status_deleted=0 checkpoints_deleted=0

  # 1. Plans — archive files older than 7 days
  local plans_dir="${HOME}/.claude/plans"
  if [ -d "$plans_dir" ]; then
    while IFS= read -r -d '' pfile; do
      [ -z "$pfile" ] && continue
      local fname
      fname="$(basename "$pfile")"
      local archive_dir
      archive_dir="${plans_dir}/archive/$(date -r "$pfile" +%Y-%m 2>/dev/null || echo "unknown")"
      if [ "$dry_run" -eq 1 ]; then
        _info "  Would archive: $fname → archive/"
      else
        mkdir -p "$archive_dir"
        mv "$pfile" "$archive_dir/"
      fi
      plans_archived=$((plans_archived + 1))
    done < <(find "$plans_dir" -maxdepth 1 -type f -name "*.md" -mtime +7 -print0 2>/dev/null)
  fi

  # 2. Events — delete files older than 3 days
  local events_dir="${HOME}/.claude/cast/events"
  if [ -d "$events_dir" ]; then
    while IFS= read -r -d '' efile; do
      [ -z "$efile" ] && continue
      if [ "$dry_run" -eq 1 ]; then
        _info "  Would delete event: $(basename "$efile")"
      else
        rm -f "$efile"
      fi
      events_deleted=$((events_deleted + 1))
    done < <(find "$events_dir" -maxdepth 1 -type f -mtime +3 -print0 2>/dev/null)
  fi

  # 3. Logs — rotate files older than 7 days or larger than 1MB
  local logs_dir="${HOME}/.claude/logs"
  if [ -d "$logs_dir" ]; then
    for logfile in "$logs_dir"/*.log "$logs_dir"/*.jsonl; do
      [ -f "$logfile" ] || continue
      local should_rotate=0
      # Check age
      if find "$logfile" -maxdepth 0 -mtime +7 -print -quit 2>/dev/null | grep -q .; then
        should_rotate=1
      fi
      # Check size (>1MB)
      local fsize
      fsize="$(stat -f%z "$logfile" 2>/dev/null || stat -c%s "$logfile" 2>/dev/null || echo 0)"
      if [ "${fsize:-0}" -gt 1048576 ]; then
        should_rotate=1
      fi
      if [ "$should_rotate" -eq 1 ]; then
        if [ "$dry_run" -eq 1 ]; then
          _info "  Would rotate: $(basename "$logfile") ($(( fsize / 1024 ))KB)"
        else
          # Rotate: .4.gz → delete, .3.gz → .4.gz, .2.gz → .3.gz, .1 → .2.gz, current → .1
          rm -f "${logfile}.4.gz"
          [ -f "${logfile}.3.gz" ] && mv "${logfile}.3.gz" "${logfile}.4.gz"
          [ -f "${logfile}.2.gz" ] && mv "${logfile}.2.gz" "${logfile}.3.gz"
          [ -f "${logfile}.1" ] && gzip -f "${logfile}.1" && mv "${logfile}.1.gz" "${logfile}.2.gz"
          mv "$logfile" "${logfile}.1"
        fi
        logs_rotated=$((logs_rotated + 1))
      fi
    done
  fi

  # 4. cast.db — prune old agent_runs, VACUUM
  if [ -f "$CAST_DB_PATH" ]; then
    local old_rows
    old_rows="$(sqlite3 "$CAST_DB_PATH" "SELECT COUNT(*) FROM agent_runs WHERE started_at < datetime('now', '-30 days');" 2>/dev/null || echo 0)"
    if [ "${old_rows:-0}" -gt 0 ]; then
      if [ "$dry_run" -eq 1 ]; then
        _info "  Would prune: $old_rows agent_runs older than 30 days"
      else
        sqlite3 "$CAST_DB_PATH" "DELETE FROM agent_runs WHERE started_at < datetime('now', '-30 days');" 2>/dev/null
      fi
      db_pruned=$old_rows
    fi
    if [ "$dry_run" -eq 0 ]; then
      sqlite3 "$CAST_DB_PATH" "VACUUM;" 2>/dev/null
    else
      _info "  Would VACUUM cast.db"
    fi
  fi

  # 5. Briefings — archive files older than 14 days
  local briefings_dir="${HOME}/.claude/briefings"
  if [ -d "$briefings_dir" ]; then
    while IFS= read -r -d '' bfile; do
      [ -z "$bfile" ] && continue
      local bname
      bname="$(basename "$bfile")"
      local barchive_dir
      barchive_dir="${briefings_dir}/archive/$(date -r "$bfile" +%Y-%m 2>/dev/null || echo "unknown")"
      if [ "$dry_run" -eq 1 ]; then
        _info "  Would archive briefing: $bname"
      else
        mkdir -p "$barchive_dir"
        mv "$bfile" "$barchive_dir/"
      fi
      briefings_archived=$((briefings_archived + 1))
    done < <(find "$briefings_dir" -maxdepth 1 -type f -name "*.md" -mtime +14 -print0 2>/dev/null)
  fi

  # 6. Agent status — delete files older than 24 hours
  local status_dir="${HOME}/.claude/agent-status"
  if [ -d "$status_dir" ]; then
    while IFS= read -r -d '' sfile; do
      [ -z "$sfile" ] && continue
      if [ "$dry_run" -eq 1 ]; then
        _info "  Would delete status: $(basename "$sfile")"
      else
        rm -f "$sfile"
      fi
      status_deleted=$((status_deleted + 1))
    done < <(find "$status_dir" -maxdepth 1 -type f -mtime +0 -print0 2>/dev/null)
  fi

  # 7. Orchestrator checkpoints — delete files older than 7 days
  local cast_dir="${HOME}/.claude/cast"
  if [ -d "$cast_dir" ]; then
    while IFS= read -r -d '' cfile; do
      [ -z "$cfile" ] && continue
      if [ "$dry_run" -eq 1 ]; then
        _info "  Would delete checkpoint: $(basename "$cfile")"
      else
        rm -f "$cfile"
      fi
      checkpoints_deleted=$((checkpoints_deleted + 1))
    done < <(find "$cast_dir" -maxdepth 1 -name "orchestrator-checkpoint-*.log" -mtime +7 -print0 2>/dev/null)
  fi

  # 8. Git worktree prune — remove stale worktree metadata entries where the
  #    directory no longer exists. Safe: only removes entries whose path is gone.
  if command -v git >/dev/null 2>&1; then
    local cast_repo_dir="${CAST_REPO_DIR:-${HOME}/Projects/personal/claude-agent-team}"
    if [ -d "$cast_repo_dir/.git" ]; then
      if [ "$dry_run" -eq 1 ]; then
        local stale_wt
        stale_wt="$(git -C "$cast_repo_dir" worktree list --porcelain 2>/dev/null | grep '^worktree ' | awk '{print $2}' | while read -r wt; do [ -d "$wt" ] || echo "$wt"; done | wc -l | tr -d ' ')"
        [ "${stale_wt:-0}" -gt 0 ] && _info "  Would prune: $stale_wt stale worktree entries"
      else
        git -C "$cast_repo_dir" worktree prune 2>/dev/null || true
        _info "  Git worktree metadata pruned"
      fi
    fi
  fi

  # Summary table
  printf "\n%-28s %-10s %s\n" "Area" "Action" "Count"
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  printf "%-28s %-10s %d\n" "Plans (>7 days)"          "archived" "$plans_archived"
  printf "%-28s %-10s %d\n" "Events (>3 days)"         "deleted"  "$events_deleted"
  printf "%-28s %-10s %d\n" "Logs (>7d or >1MB)"       "rotated"  "$logs_rotated"
  printf "%-28s %-10s %d\n" "DB agent_runs (>30 days)"  "pruned"   "$db_pruned"
  printf "%-28s %-10s %d\n" "Briefings (>14 days)"     "archived" "$briefings_archived"
  printf "%-28s %-10s %d\n" "Agent status (>24h)"      "deleted"  "$status_deleted"
  printf "%-28s %-10s %d\n" "Checkpoints (>7 days)"    "deleted"  "$checkpoints_deleted"

  local total=$((plans_archived + events_deleted + logs_rotated + db_pruned + briefings_archived + status_deleted + checkpoints_deleted))
  printf "%s\n" "$(python3 -c "print('-' * 52)" 2>/dev/null || printf '%0.s-' {1..52})"
  if [ "$dry_run" -eq 1 ]; then
    printf "${C_YELLOW}Dry run: %d items would be affected${C_RESET}\n" "$total"
  else
    printf "${C_GREEN}Tidy complete: %d items processed${C_RESET}\n" "$total"
  fi
}

# ── Subcommand: install-completions ──────────────────────────────────────────
_cmd_install_completions() {
  local completions_src="${CAST_REPO_DIR}/completions"

  if [ ! -d "$completions_src" ]; then
    _warn "Completions directory not found: $completions_src"
    return 1
  fi

  local zsh_installed=0
  local bash_installed=0

  local zsh_comp="${completions_src}/_cast"
  if [ -f "$zsh_comp" ]; then
    local zsh_dir="${HOME}/.zsh/completions"
    mkdir -p "$zsh_dir"
    cp "$zsh_comp" "${zsh_dir}/_cast"
    zsh_installed=1
    _success "zsh completion installed: ${zsh_dir}/_cast"
    _info "  Add to ~/.zshrc: fpath=(~/.zsh/completions \$fpath) && autoload -U compinit && compinit"
  fi

  local bash_comp="${completions_src}/cast.bash"
  if [ -f "$bash_comp" ]; then
    local bash_dir="${HOME}/.bash_completion.d"
    mkdir -p "$bash_dir"
    cp "$bash_comp" "${bash_dir}/cast"
    bash_installed=1
    _success "bash completion installed: ${bash_dir}/cast"
    _info "  Add to ~/.bashrc: source ~/.bash_completion.d/cast"
  fi

  if [ "$zsh_installed" -eq 0 ] && [ "$bash_installed" -eq 0 ]; then
    _warn "No completion files found in $completions_src"
    return 1
  fi
}

# ── Subcommand: clean ───────────────────────────────────────────────────────
_cmd_clean() {
  local apply=0
  local do_worktrees=0

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --apply)      apply=1; shift ;;
      --worktrees)  do_worktrees=1; shift ;;
      --help|-h)
        cat <<USAGE
Usage: cast clean [--apply] [--worktrees]

  (no flags)     Dry-run: print what would be deleted, change nothing
  --apply        Actually delete stale branches
  --worktrees    Also prune dead worktree directories

Branch deletion policy:
  cast-swarm-*    : last commit > 7 days ago AND no open PR
  worktree-agent-*: last commit > 7 days ago
  feature/* fix/* : merged into main AND remote tracking ref is [gone]

Hard whitelist (never deleted):
  main, feat/*, feature/cast-v7-*, branches checked out in any worktree

Examples:
  cast clean                  — preview what would be removed
  cast clean --apply          — delete stale branches
  cast clean --apply --worktrees  — delete stale branches + dead worktrees
USAGE
        return 0
        ;;
      -*)
        _error "Unknown flag: $1"
        printf "  Run: cast clean --help\n" >&2
        return 1
        ;;
      *) shift ;;
    esac
  done

  # Resolve groomer script: installed copy first, repo fallback
  local groomer_script="${CAST_SCRIPTS_DIR}/cast-branch-groomer.sh"
  if [ ! -f "$groomer_script" ]; then
    groomer_script="${CAST_REPO_DIR}/scripts/cast-branch-groomer.sh"
  fi
  if [ ! -f "$groomer_script" ]; then
    _error "cast-branch-groomer.sh not found. Run: bash install.sh"
    return 1
  fi

  # Build flags
  local groomer_flags=()
  if [ "$apply" -eq 1 ]; then
    groomer_flags+=("--apply")
  else
    groomer_flags+=("--dry-run")
  fi
  [ "$do_worktrees" -eq 1 ] && groomer_flags+=("--worktrees")

  bash "$groomer_script" "${groomer_flags[@]}"
}

# ── Subcommand: dash ────────────────────────────────────────────────────────
_cmd_dash() {
  local dash_script="${CAST_SCRIPTS_DIR}/cast-dash.py"
  local venv_python="${HOME}/.claude/venv/bin/python3"
  local python_cmd="python3"

  if [ -x "$venv_python" ]; then
    python_cmd="$venv_python"
  fi

  if [ ! -f "$dash_script" ]; then
    _error "cast-dash.py not found. Run: bash install.sh"
    exit 1
  fi

  # Verify textual is available
  if ! "$python_cmd" -c "import textual" 2>/dev/null; then
    _error "textual is not installed."
    printf "  Install: %s -m pip install textual\n" "$python_cmd" >&2
    printf "  Or run:  bash install.sh  (from claude-agent-team repo)\n" >&2
    exit 1
  fi

  CAST_DB_PATH="${CAST_DB_PATH}" exec "$python_cmd" "$dash_script" "$@"
}

# ── Subcommand: routines ─────────────────────────────────────────────────────
_cmd_routines() {
  local routines_script="${CAST_SCRIPTS_DIR}/cast-db-routines.py"
  if [ ! -f "$routines_script" ]; then
    routines_script="${CAST_REPO_DIR}/scripts/cast-db-routines.py"
  fi
  if [ ! -f "$routines_script" ]; then
    _error "cast-db-routines.py not found. Run: bash install.sh"
    exit 1
  fi

  local routine_runner="${CAST_SCRIPTS_DIR}/cast-routine-runner.sh"
  if [ ! -f "$routine_runner" ]; then
    routine_runner="${CAST_REPO_DIR}/scripts/cast-routine-runner.sh"
  fi

  local routines_dir="${CAST_ROUTINES_DIR:-$HOME/.claude/routines}"
  local crontab_cmd="${CAST_CRONTAB_CMD:-crontab}"

  local subcmd="${1:-}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list|status|get)
      CAST_DB_PATH="${CAST_DB_PATH}" python3 "$routines_script" "$subcmd" "$@"
      ;;

    trigger)
      local routine_name="${1:?Usage: cast routines trigger <name> [--dry-run]}"
      shift
      if [ ! -f "$routine_runner" ]; then
        _error "cast-routine-runner.sh not found. Run: bash install.sh"
        exit 1
      fi
      CAST_ROUTINES_DIR="$routines_dir" \
        CAST_DB_PATH="${CAST_DB_PATH}" \
        CAST_REPO_DIR="${CAST_REPO_DIR}" \
        bash "$routine_runner" "$routine_name" "$@"
      ;;

    install)
      local yaml_path="${1:?Usage: cast routines install <yaml-path>}"
      if [ ! -f "$yaml_path" ]; then
        _error "YAML file not found: $yaml_path"
        exit 1
      fi
      # Parse fields from YAML
      local name trigger_type trigger_value agent prompt_template output_dir enabled
      name="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('name',''))" "$yaml_path")"
      trigger_type="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('trigger',{}).get('type','manual'))" "$yaml_path")"
      trigger_value="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('trigger',{}).get('value','') or '')" "$yaml_path")"
      agent="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('agent',''))" "$yaml_path")"
      prompt_template="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('prompt_template',''))" "$yaml_path")"
      output_dir="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('output_dir',''))" "$yaml_path")"
      enabled="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(1 if d.get('enabled',True) else 0)" "$yaml_path")"

      if [ -z "$name" ]; then
        _error "YAML missing required field: name"
        exit 1
      fi

      # Validate routine name (prevent path traversal)
      if ! [[ "$name" =~ ^[a-z][a-z0-9_-]{0,63}$ ]]; then
        _error "Invalid routine name: '$name'. Must match ^[a-z][a-z0-9_-]{0,63}\$ (start with lowercase letter, lowercase alphanumerics + hyphen + underscore, max 64 chars)."
        return 1
      fi

      # Copy YAML to routines dir
      mkdir -p "$routines_dir"
      cp "$yaml_path" "$routines_dir/$name.yaml"

      # Upsert into DB
      local upsert_json
      upsert_json="$(python3 -c "
import json, sys
print(json.dumps({
  'name': sys.argv[1],
  'trigger_type': sys.argv[2],
  'trigger_value': sys.argv[3] or None,
  'agent_to_dispatch': sys.argv[4],
  'prompt_template': sys.argv[5],
  'output_dir': sys.argv[6],
  'enabled': int(sys.argv[7]),
}))" "$name" "$trigger_type" "$trigger_value" "$agent" "$prompt_template" "$output_dir" "$enabled")"

      echo "$upsert_json" | CAST_DB_PATH="${CAST_DB_PATH}" python3 "$routines_script" upsert

      # Install crontab entry if trigger is cron
      if [ "$trigger_type" = "cron" ] && [ -n "$trigger_value" ]; then
        # Validate cron expression (5 fields of [0-9*,/-]+ separated by whitespace)
        if ! [[ "$trigger_value" =~ ^[0-9*,/-]+[[:space:]]+[0-9*,/-]+[[:space:]]+[0-9*,/-]+[[:space:]]+[0-9*,/-]+[[:space:]]+[0-9*,/-]+$ ]]; then
          _error "Invalid cron expression in trigger_value: '$trigger_value'. Must be 5 fields of [0-9*,/-]+ separated by whitespace."
          return 1
        fi
        local cron_entry="$trigger_value bash $routine_runner $name --from-cron"
        ( "$crontab_cmd" -l 2>/dev/null; echo "$cron_entry" ) | sort -u | "$crontab_cmd" -
        echo "Installed cron entry: $cron_entry"
      fi

      echo "Installed routine: $name"
      ;;

    uninstall)
      local routine_name="${1:?Usage: cast routines uninstall <name>}"
      # Validate routine name (prevent path traversal)
      if ! [[ "$routine_name" =~ ^[a-z][a-z0-9_-]{0,63}$ ]]; then
        _error "Invalid routine name: '$routine_name'. Must match ^[a-z][a-z0-9_-]{0,63}\$ (start with lowercase letter, lowercase alphanumerics + hyphen + underscore, max 64 chars)."
        return 1
      fi
      # Remove crontab entry
      "$crontab_cmd" -l 2>/dev/null | grep -vF "cast-routine-runner.sh $routine_name --from-cron" | "$crontab_cmd" - 2>/dev/null || true
      # Mark disabled in DB
      local upsert_json
      upsert_json="$(python3 -c "
import json, sys
print(json.dumps({'name': sys.argv[1], 'trigger_type': 'manual', 'agent_to_dispatch': '', 'prompt_template': '', 'enabled': 0}))" "$routine_name")"
      # Use update directly — only flip enabled flag
      CAST_DB_PATH="${CAST_DB_PATH}" python3 "$routines_script" enable-disable "$routine_name" "0" 2>/dev/null || true
      echo "Uninstalled routine: $routine_name (YAML preserved; re-run install to re-enable)"
      ;;

    enable)
      local routine_name="${1:?Usage: cast routines enable <name>}"
      # Validate routine name (prevent path traversal)
      if ! [[ "$routine_name" =~ ^[a-z][a-z0-9_-]{0,63}$ ]]; then
        _error "Invalid routine name: '$routine_name'. Must match ^[a-z][a-z0-9_-]{0,63}\$ (start with lowercase letter, lowercase alphanumerics + hyphen + underscore, max 64 chars)."
        return 1
      fi
      CAST_DB_PATH="${CAST_DB_PATH}" python3 "$routines_script" enable-disable "$routine_name" "1"
      # Reinstall cron entry if YAML present
      local yaml_file="$routines_dir/$routine_name.yaml"
      if [ -f "$yaml_file" ]; then
        local trigger_type trigger_value
        trigger_type="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('trigger',{}).get('type','manual'))" "$yaml_file")"
        trigger_value="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])); print(d.get('trigger',{}).get('value','') or '')" "$yaml_file")"
        if [ "$trigger_type" = "cron" ] && [ -n "$trigger_value" ]; then
          local cron_entry="$trigger_value bash $routine_runner $routine_name --from-cron"
          ( "$crontab_cmd" -l 2>/dev/null; echo "$cron_entry" ) | sort -u | "$crontab_cmd" -
          echo "Reinstalled cron entry for: $routine_name"
        fi
      fi
      echo "Enabled routine: $routine_name"
      ;;

    disable)
      local routine_name="${1:?Usage: cast routines disable <name>}"
      # Validate routine name (prevent path traversal)
      if ! [[ "$routine_name" =~ ^[a-z][a-z0-9_-]{0,63}$ ]]; then
        _error "Invalid routine name: '$routine_name'. Must match ^[a-z][a-z0-9_-]{0,63}\$ (start with lowercase letter, lowercase alphanumerics + hyphen + underscore, max 64 chars)."
        return 1
      fi
      CAST_DB_PATH="${CAST_DB_PATH}" python3 "$routines_script" enable-disable "$routine_name" "0"
      # Remove cron entry
      "$crontab_cmd" -l 2>/dev/null | grep -vF "cast-routine-runner.sh $routine_name --from-cron" | "$crontab_cmd" - 2>/dev/null || true
      echo "Disabled routine: $routine_name"
      ;;

    validate)
      local yaml_path="${1:?Usage: cast routines validate <yaml-path>}"
      if [ ! -f "$yaml_path" ]; then
        _error "YAML file not found: $yaml_path"
        exit 1
      fi
      local errors=0
      # Check required fields
      local check_result
      check_result="$(python3 - "$yaml_path" "${CAST_REPO_DIR:-$(cd "$(dirname "$routine_runner")/.." && pwd)}" <<'PYEOF'
import yaml, sys, os, json

yaml_path = sys.argv[1]
repo_dir  = sys.argv[2]
errors = []

try:
    with open(yaml_path) as f:
        data = yaml.safe_load(f)
except yaml.YAMLError as e:
    print(f"ERROR: invalid YAML: {e}")
    sys.exit(1)

required_top = ["name", "agent", "prompt_template", "output_dir"]
for field in required_top:
    if not data.get(field):
        errors.append(f"missing required field: {field}")

trigger = data.get("trigger", {})
if not isinstance(trigger, dict):
    errors.append("'trigger' must be a mapping")
else:
    if not trigger.get("type"):
        errors.append("missing required field: trigger.type")
    if not trigger.get("value") and trigger.get("type") == "cron":
        errors.append("missing required field: trigger.value (required when trigger.type=cron)")

agent = data.get("agent", "")
if agent:
    agent_file = os.path.join(repo_dir, "agents", "core", f"{agent}.md")
    if not os.path.isfile(agent_file):
        errors.append(f"agent not found in agents/core/: {agent}")

if errors:
    for e in errors:
        print(f"ERROR: {e}")
    sys.exit(1)
else:
    print(f"OK: {data.get('name')} (agent: {agent})")
PYEOF
      )"
      local exit_code=$?
      echo "$check_result"
      exit $exit_code
      ;;

    ""|--help|-h)
      echo "Usage: cast routines <subcommand> [args]"
      echo ""
      echo "Subcommands:"
      echo "  list                         List all routines"
      echo "  status [name]                Show detailed status"
      echo "  get <name>                   Get a single routine record"
      echo "  install <yaml-path>          Install routine from YAML spec"
      echo "  uninstall <name>             Remove cron entry and disable routine"
      echo "  trigger <name> [--dry-run] [--arg key=value ...]  Trigger a routine manually"
      echo "  enable <name>                Enable routine (reinstalls cron)"
      echo "  disable <name>               Disable routine (removes cron)"
      echo "  validate <yaml-path>         Validate a routine YAML spec"
      ;;

    *)
      # Fall through to cast-db-routines.py for any unrecognised subcommand
      # (allows direct use of: cast routines upsert, cast routines update-status, etc.)
      CAST_DB_PATH="${CAST_DB_PATH}" python3 "$routines_script" "$subcmd" "$@"
      ;;
  esac
}

# ── Subcommand: db-contract ──────────────────────────────────────────────────
_cmd_db_contract() {
  # Prefer the repo version: cast-db-contract.py resolves REPO_ROOT from its own
  # __file__ location to find cast-db-init.sh, migrations/, and the baseline.
  # The installed copy in CAST_SCRIPTS_DIR has a mismatched REPO_ROOT (points to
  # ~/.claude instead of the repo), so repo-first resolution is correct here.
  local _dbc_script="${CAST_REPO_DIR}/scripts/cast-db-contract.py"
  if [ ! -f "$_dbc_script" ]; then
    _dbc_script="${CAST_SCRIPTS_DIR}/cast-db-contract.py"
  fi
  if [ ! -f "$_dbc_script" ]; then
    _error "cast-db-contract.py not found. Run: bash install.sh"
    exit 1
  fi
  # --json is consumed globally by _parse_global_flags (sets CAST_JSON=1) and
  # never reaches $@. Re-inject it so the python script receives it.
  if [ "${CAST_JSON:-0}" -eq 1 ]; then
    set -- "--json" "$@"
  fi
  exec python3 "$_dbc_script" "$@"
}

# ── Subcommand: ci-local ─────────────────────────────────────────────────────
_cmd_ci_local() {
  # Detect flagship repo by verifying a Makefile with a ci-local target is present.
  # CAST_REPO_DIR resolves to the repo root via the readlink -f symlink resolution at
  # script startup, so this works whether cast is run from the repo or from a PATH symlink.
  local makefile="${CAST_REPO_DIR}/Makefile"
  if [ ! -f "$makefile" ] || ! grep -q '^ci-local:' "$makefile"; then
    _error "cast ci-local requires the flagship claude-agent-team repo."
    printf "  Expected Makefile with a ci-local target at: %s\n" "$CAST_REPO_DIR" >&2
    printf "  Ensure cast was installed from the claude-agent-team repo and retry.\n" >&2
    exit 1
  fi

  # Delegate to make ci-local from the repo root
  exec make -C "$CAST_REPO_DIR" ci-local
}

# ── Subcommand: incidents ────────────────────────────────────────────────────
_cmd_incidents() {
  local incidents_script="${CAST_SCRIPTS_DIR}/cast-db-incidents.py"
  if [ ! -f "$incidents_script" ]; then
    incidents_script="${CAST_REPO_DIR}/scripts/cast-db-incidents.py"
  fi
  if [ ! -f "$incidents_script" ]; then
    _error "cast-db-incidents.py not found. Run: bash install.sh"
    exit 1
  fi
  CAST_DB_PATH="${CAST_DB_PATH}" exec python3 "$incidents_script" "$@"
}

# ── Subcommand: files ────────────────────────────────────────────────────────
_cmd_files() {
  local files_script="${CAST_SCRIPTS_DIR}/cast-files-api.sh"
  if [ ! -f "$files_script" ]; then
    files_script="${CAST_REPO_DIR}/scripts/cast-files-api.sh"
  fi
  if [ ! -f "$files_script" ]; then
    _error "cast-files-api.sh not found. Run: bash install.sh"
    exit 1
  fi
  exec bash "$files_script" "$@"
}

# ── Subcommand: stack ────────────────────────────────────────────────────────
_cmd_stack() {
  local subcmd="${1:-show}"
  shift 2>/dev/null || true
  local target_path="${1:-$PWD}"

  case "$subcmd" in
    show)
      # Resolve and validate path
      if [ ! -d "$target_path" ]; then
        _error "Path not found: $target_path"
        exit 1
      fi
      local cast_json="${target_path}/.claude/cast.json"
      if [ ! -f "$cast_json" ]; then
        printf "No .claude/cast.json found at %s\n" "$target_path"
        printf "Run: cast stack refresh %s\n" "$target_path"
        exit 0
      fi
      TARGET_PATH="$target_path" CAST_JSON="$cast_json" python3 - <<'STACK_SHOW_PY'
import json, os, sys
from datetime import datetime, timezone

cast_json = os.environ.get('CAST_JSON', '')
target_path = os.environ.get('TARGET_PATH', '')

try:
    with open(cast_json) as f:
        data = json.load(f)
except Exception as e:
    print(f"Error reading {cast_json}: {e}", file=sys.stderr)
    sys.exit(1)

stack = data.get('stack')
if not stack:
    print(f"No stack profile inferred yet. Run: cast stack refresh {target_path}")
    sys.exit(0)

if stack.get('_manual'):
    print("[manual override — auto-detect disabled]")

print(f"  language:     {stack.get('language', 'unknown')}")
print(f"  framework:    {stack.get('framework', 'unknown')}")
if stack.get('test_cmd'):
    print(f"  test_cmd:     {stack['test_cmd']}")
if stack.get('build_cmd'):
    print(f"  build_cmd:    {stack['build_cmd']}")
if stack.get('lint_cmd'):
    print(f"  lint_cmd:     {stack['lint_cmd']}")
if stack.get('deploy_style'):
    print(f"  deploy_style: {stack['deploy_style']}")

inferred_at = stack.get('inferred_at', '')
if inferred_at:
    try:
        dt = datetime.fromisoformat(inferred_at.replace('Z', '+00:00'))
        delta = datetime.now(timezone.utc) - dt
        total_seconds = int(delta.total_seconds())
        if total_seconds < 3600:
            age = f"{total_seconds // 60} minutes ago"
        elif total_seconds < 86400:
            age = f"{total_seconds // 3600} hours ago"
        else:
            age = f"{delta.days} days ago"
    except Exception:
        age = inferred_at
    print(f"  inferred_at:  {inferred_at} ({age})")
    print(f"  inferred_by:  {stack.get('inferred_by', 'unknown')}")
STACK_SHOW_PY
      ;;

    refresh)
      if [ ! -d "$target_path" ]; then
        _error "Path not found: $target_path"
        exit 1
      fi
      local detect_script="${CAST_SCRIPTS_DIR}/cast-stack-detect.sh"
      if [ ! -f "$detect_script" ]; then
        detect_script="${CAST_REPO_DIR}/scripts/cast-stack-detect.sh"
      fi
      if [ ! -f "$detect_script" ]; then
        _error "cast-stack-detect.sh not found. Run: bash install.sh"
        exit 1
      fi
      _info "Refreshing stack profile for: $target_path"
      local result
      result="$(bash "$detect_script" "$target_path" --write --force 2>/dev/null)" || true
      if [ -n "$result" ]; then
        printf "%s\n" "$result" | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(f\"  framework:  {d.get('framework','unknown')}\")
    print(f\"  language:   {d.get('language','unknown')}\")
    if d.get('test_cmd'):  print(f\"  test_cmd:   {d['test_cmd']}\")
    if d.get('build_cmd'): print(f\"  build_cmd:  {d['build_cmd']}\")
    if d.get('lint_cmd'):  print(f\"  lint_cmd:   {d['lint_cmd']}\")
    print(f\"  inferred_at: {d.get('inferred_at','')}\")
except Exception:
    sys.exit(1)
" 2>/dev/null || printf "%s\n" "$result"
        _success "Stack profile updated."
      else
        _warn "Detection returned empty result."
      fi
      ;;

    *)
      _error "Unknown stack subcommand: $subcmd"
      printf "  Usage: cast stack show|refresh [path]\n" >&2
      exit 1
      ;;
  esac
}

# ── Subcommand: batch ────────────────────────────────────────────────────────
_cmd_batch() {
  local batch_script="${CAST_SCRIPTS_DIR}/cast-batch-dispatch.sh"
  if [ ! -f "$batch_script" ]; then
    batch_script="${CAST_REPO_DIR}/scripts/cast-batch-dispatch.sh"
  fi
  if [ ! -f "$batch_script" ]; then
    _error "cast-batch-dispatch.sh not found. Run: bash install.sh"
    exit 1
  fi
  exec bash "$batch_script" "$@"
}

# ── Main dispatch ────────────────────────────────────────────────────────────
if [ "$#" -gt 0 ]; then
  CAST_ARGS=("$@")
else
  CAST_ARGS=()
fi
if [ "${#CAST_ARGS[@]}" -gt 0 ]; then
  _parse_global_flags "${CAST_ARGS[@]}"
else
  _parse_global_flags
fi
if [ "${#CAST_ARGS[@]}" -gt 0 ]; then
  set -- "${CAST_ARGS[@]}"
else
  set --
fi

SUBCOMMAND="${1:-}"
shift 2>/dev/null || true

case "$SUBCOMMAND" in
  init-repo)            _cmd_init_repo "$@" ;;
  new-agent)            _cmd_new_agent "$@" ;;
  status)               _cmd_status "$@" ;;
  exec)                 _cmd_exec "$@" ;;
  dispatch)             _cmd_dispatch "$@" ;;
  parallel)
    parallel_script="${CAST_SCRIPTS_DIR}/cast-parallel.sh"
    if [ ! -f "$parallel_script" ]; then
      parallel_script="${CAST_REPO_DIR}/scripts/cast-parallel.sh"
    fi
    if [ ! -f "$parallel_script" ]; then
      _error "cast-parallel.sh not found. Run: bash install.sh"
      exit 1
    fi
    exec bash "$parallel_script" "$@"
    ;;
  test)                 _cmd_test "$@" ;;
  memory)               _cmd_memory "$@" ;;
  budget)               _cmd_budget "$@" ;;
  agents)               _cmd_agents "$@" ;;
  hooks)                _cmd_hooks "$@" ;;
  backup)               _cmd_backup "$@" ;;
  doctor)               _cmd_doctor "$@" ;;
  upgrade-check)        _cmd_upgrade_check "$@" ;;
  migrate)              _cmd_migrate "$@" ;;
  tidy)                 _cmd_tidy "$@" ;;
  clean)                _cmd_clean "$@" ;;
  dash)                 _cmd_dash "$@" ;;
  install-completions)  _cmd_install_completions "$@" ;;
  routines)             _cmd_routines "$@" ;;
  incidents)            _cmd_incidents "$@" ;;
  files)                _cmd_files "$@" ;;
  batch)                _cmd_batch "$@" ;;
  ci-local)             _cmd_ci_local "$@" ;;
  db-contract)          _cmd_db_contract "$@" ;;
  stack)                _cmd_stack "$@" ;;
  ""|--help|-h)
    _usage
    exit 0
    ;;
  *)
    _error "Unknown subcommand: $SUBCOMMAND"
    printf "  Run: cast --help\n" >&2
    exit 1
    ;;
esac
