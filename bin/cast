#!/usr/bin/env bash
# cast — CAST CLI (v4 rebuild)
# Main entrypoint for all cast subcommands.
#
# Usage: cast <subcommand> [args] [--json] [--quiet] [--verbose]
#
# Subcommands: status, exec, parallel, memory, budget, agents, hooks, doctor, upgrade-check, tidy, clean, dash, install-completions
#
# Config: ~/.claude/config/cast-cli.json
# DB:     $CAST_DB_PATH or ~/.claude/cast.db

set -uo pipefail

# ── Script directory (resolve symlinks) ──────────────────────────────────────
CAST_BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
CAST_REPO_DIR="${CAST_REPO_DIR:-$(cd "$CAST_BIN_DIR/.." && pwd)}"

# ── Version ──────────────────────────────────────────────────────────────────
CAST_VERSION="$(cat "${CAST_REPO_DIR}/VERSION" 2>/dev/null || echo "unknown")"
CAST_SCRIPTS_DIR="${HOME}/.claude/scripts"
CAST_AGENTS_DIR="${HOME}/.claude/agents"

# ── Global flags ─────────────────────────────────────────────────────────────
CAST_JSON=0
CAST_QUIET=0
CAST_VERBOSE=0

# ── Load config ──────────────────────────────────────────────────────────────
CAST_CONFIG_FILE="${HOME}/.claude/config/cast-cli.json"

_config_get() {
  local key="$1"
  local default="${2:-}"
  if [ -f "$CAST_CONFIG_FILE" ] && command -v python3 >/dev/null 2>&1; then
    python3 -c "
import json, sys
try:
    with open('$CAST_CONFIG_FILE') as f:
        cfg = json.load(f)
    val = cfg.get('$key', '$default')
    if val:
        print(str(val).replace('~', __import__('os').path.expanduser('~')))
    else:
        print('$default')
except Exception:
    print('$default')
" 2>/dev/null || echo "$default"
  else
    echo "$default"
  fi
}

# Resolve DB path: env var > config file > default
if [ -z "${CAST_DB_PATH:-}" ]; then
  _cfg_db="$(_config_get db_path "${HOME}/.claude/cast.db")"
  CAST_DB_PATH="${_cfg_db:-${HOME}/.claude/cast.db}"
fi
export CAST_DB_PATH

# ── Colors ───────────────────────────────────────────────────────────────────
if [ -t 1 ] && [ "${TERM:-}" != "dumb" ]; then
  C_BOLD='\033[1m'
  C_GREEN='\033[0;32m'
  C_YELLOW='\033[0;33m'
  C_CYAN='\033[0;36m'
  C_RED='\033[0;31m'
  C_DIM='\033[2m'
  C_RESET='\033[0m'
else
  C_BOLD='' C_GREEN='' C_YELLOW='' C_CYAN='' C_RED='' C_DIM='' C_RESET=''
fi

# ── Helpers ──────────────────────────────────────────────────────────────────
_info()    { [ "$CAST_QUIET" -eq 0 ] && printf "${C_CYAN}%s${C_RESET}\n" "$*"; }
_success() { [ "$CAST_QUIET" -eq 0 ] && printf "${C_GREEN}%s${C_RESET}\n" "$*"; }
_warn()    { printf "${C_YELLOW}%s${C_RESET}\n" "$*" >&2; }
_error()   { printf "${C_RED}Error: %s${C_RESET}\n" "$*" >&2; }
_verbose() { [ "$CAST_VERBOSE" -eq 1 ] && printf "${C_DIM}[verbose] %s${C_RESET}\n" "$*" >&2; }

_require_db() {
  if [ ! -f "$CAST_DB_PATH" ]; then
    _error "cast.db not found at $CAST_DB_PATH"
    printf "  Run: bash %s/cast-db-init.sh\n" "$CAST_SCRIPTS_DIR" >&2
    exit 1
  fi
  if ! command -v sqlite3 >/dev/null 2>&1; then
    _error "sqlite3 not found in PATH"
    exit 1
  fi
}

_db() {
  sqlite3 "$CAST_DB_PATH" "$@"
}

_parse_global_flags() {
  local remaining=()
  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --json)     CAST_JSON=1; shift ;;
      --quiet)    CAST_QUIET=1; shift ;;
      --verbose)  CAST_VERBOSE=1; shift ;;
      --help|-h)
        _usage
        exit 0
        ;;
      --version)
        echo "cast version ${CAST_VERSION}"
        exit 0
        ;;
      *)
        remaining+=("$1")
        shift
        ;;
    esac
  done
  if [ "${#remaining[@]}" -gt 0 ]; then
    CAST_ARGS=("${remaining[@]}")
  else
    CAST_ARGS=()
  fi
}

# ── Usage ────────────────────────────────────────────────────────────────────
_usage() {
  cat <<USAGE
${C_BOLD}CAST v${CAST_VERSION}${C_RESET}

Usage: cast <subcommand> [args] [flags]

Subcommands:
  ${C_BOLD}init-repo${C_RESET}                       Initialize CAST config for this repo
  ${C_BOLD}new-agent${C_RESET}  <name>                  Scaffold a new agent frontmatter file
  ${C_BOLD}status${C_RESET}                          Terminal health dashboard
  ${C_BOLD}exec${C_RESET}      [--resume|--status] <plan>  Execute a plan manifest
  ${C_BOLD}parallel${C_RESET}  [--dry-run] [--split N] <plan>  Split plan across parallel worktrees
  ${C_BOLD}dispatch${C_RESET}  [--managed] <agent> <prompt>  Dispatch an agent task
  ${C_BOLD}test${C_RESET}      [agent-name] [--record] [--ci]  Run agent contract tests
  ${C_BOLD}memory${C_RESET}    search|list|forget|export   Query and manage agent memories
  ${C_BOLD}budget${C_RESET}    [--week] [--project]        View cost summary
  ${C_BOLD}agents${C_RESET}                          List installed CAST agents
  ${C_BOLD}hooks${C_RESET}                           Show active hooks with health status
  ${C_BOLD}backup${C_RESET}    [--overlay]               On-disk snapshot (+ GitHub overlay with --overlay)
  ${C_BOLD}doctor${C_RESET}                          Run system health check
  ${C_BOLD}upgrade-check${C_RESET}                   Check configured repos for new releases
  ${C_BOLD}migrate${C_RESET}   [--dry-run]               Apply pending DB schema migrations
  ${C_BOLD}tidy${C_RESET}      [--dry-run]               Clean up old plans, events, logs, briefings
  ${C_BOLD}clean${C_RESET}     [--apply] [--worktrees]   Prune stale branches (dry-run by default)
  ${C_BOLD}dash${C_RESET}                            Live TUI dashboard (htop for CAST)
  ${C_BOLD}install-completions${C_RESET}             Install shell tab completions
  ${C_BOLD}incidents${C_RESET} recent|search              Query episodic incident history
  ${C_BOLD}routines${C_RESET} list|status|get|trigger|install|uninstall|enable|disable|validate  Manage scheduled agent routines
  ${C_BOLD}files${C_RESET}                              File event tracking and analytics
  ${C_BOLD}batch${C_RESET}                              Batch dispatch orchestration
  ${C_BOLD}ci-local${C_RESET}                           Run PR-gating CI workflows locally via act
  ${C_BOLD}db-contract${C_RESET} [--json] [--check] [--update-baseline]  Schema/DB-contract reconciliation
  ${C_BOLD}stack${C_RESET}     show|refresh [path]          Show or refresh per-repo stack profile

Global flags:
  --json        Machine-readable JSON output
  --quiet       Suppress informational messages
  --verbose     Show debug details
  --help, -h    Show this help
  --version     Show version

Config: ${CAST_CONFIG_FILE}
DB:     ${CAST_DB_PATH}
USAGE
}

# ── Subcommand: init-repo ────────────────────────────────────────────────────
_cmd_init_repo() {
  local target_dir="${PWD}"
  local claude_dir="${target_dir}/.claude"
  local config_file="${claude_dir}/cast.json"

  # Idempotent: already initialized
  if [ -f "$config_file" ]; then
    printf "Already initialized.\n"
    printf "\nCurrent config (%s):\n" "$config_file"
    if command -v python3 >/dev/null 2>&1; then
      python3 -m json.tool "$config_file" 2>/dev/null || cat "$config_file"
    else
      cat "$config_file"
    fi
    return 0
  fi

  # Detect repo class from git remote URL
  local repo_class="personal"
  local co_author_trailer="claude"
  local remote_url
  remote_url="$(git remote get-url origin 2>/dev/null || true)"

  if echo "$remote_url" | grep -q "bitbucket.org"; then
    repo_class="work"
    co_author_trailer="none"
  elif echo "$remote_url" | grep -q "github.com"; then
    repo_class="personal"
    co_author_trailer="claude"
  elif [ -n "$remote_url" ]; then
    # Unknown remote — default to personal
    repo_class="personal"
    co_author_trailer="claude"
  fi
  # No remote: default to personal

  # Create .claude/ dir if needed
  mkdir -p "$claude_dir"

  # Write cast.json
  python3 - "$config_file" "$repo_class" "$co_author_trailer" <<'PYEOF'
import sys, json
config_file, repo_class, co_author_trailer = sys.argv[1], sys.argv[2], sys.argv[3]
config = {
    "repo_class": repo_class,
    "co_author_trailer": co_author_trailer,
    "budget": {
        "per_dispatch_limit_usd": 1.00
    }
}
with open(config_file, 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')
print(json.dumps(config, indent=2))
PYEOF

  printf "\nCAST initialized for this repo.\n"
  printf "  Repo class:    %s\n" "$repo_class"
  printf "  Co-author:     %s\n" "$co_author_trailer"
  printf "\nNext steps:\n"
  printf "  cast status     — see what CAST is doing\n"
  printf "  cast dispatch   — run an agent\n"
  printf "  cast test       — run contract tests (coming soon)\n"
  printf "\nDocs: https://github.com/ek33450505/claude-agent-team\n"
}

# ── Subcommand: new-agent ────────────────────────────────────────────────────
_cmd_new_agent() {
  local agent_name="${1:-}"

  if [[ -z "$agent_name" ]]; then
    printf "Usage: cast new-agent <name>\n" >&2
    exit 1
  fi

  # Validate: alphanumeric + hyphens only, no path traversal
  if ! [[ "$agent_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]; then
    printf "Error: agent name must be alphanumeric with hyphens only\n" >&2
    exit 1
  fi

  local agents_dir="${HOME}/.claude/agents"
  local agent_file="${agents_dir}/${agent_name}.md"

  mkdir -p "$agents_dir"

  if [[ -f "$agent_file" ]]; then
    printf "Agent already exists: %s\n" "$agent_file" >&2
    exit 1
  fi

  cat > "$agent_file" <<FRONTMATTER
---
name: ${agent_name}
description: TODO — describe when to use this agent
tools: Read, Write, Edit, Bash, Glob, Grep
model: haiku
# ── CAST-extension fields ────────────────────────────────────────────────────
maxTurns: 20
skills: [cast-conventions]
thinking_budget: 0
---

# ${agent_name}

TODO — write agent instructions here.
FRONTMATTER

  printf "Created: %s\n" "$agent_file"
  printf "Edit the description and instructions, then run: cast agents\n"
}

# ── Subcommand: dispatch ─────────────────────────────────────────────────────
_cmd_dispatch() {
  local use_managed=0
  local beta_header="managed-agents-2026-04-01"
  local no_stream=0
  local dry_run=0
  local agent_name=""
  local prompt=""

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --managed)              use_managed=1; shift ;;
      --beta-header)          beta_header="${2:-}"; shift 2 ;;
      --no-stream)            no_stream=1; shift ;;
      --dry-run)              dry_run=1; shift ;;
      --help|-h)
        cat <<USAGE
Usage: cast dispatch [--managed] <agent> <prompt>

  --managed              Use Managed Agents API (Anthropic cloud execution)
  --beta-header <value>  Override beta header (default: managed-agents-2026-04-01)
  --no-stream            Disable streaming (for CI/non-TTY contexts)
  --dry-run              Print the curl command without executing

Without --managed: prints instructions for local dispatch via Claude Code.
With --managed: calls scripts/cast-managed-agent.sh with appropriate flags.

Examples:
  cast dispatch --managed code-reviewer "Review my recent changes"
  cast dispatch --dry-run --managed code-reviewer "test"
  cast dispatch --managed --no-stream commit "Implement feature X"
USAGE
        return 0
        ;;
      -*)
        _error "Unknown flag: $1"
        printf "  Run: cast dispatch --help\n" >&2
        return 1
        ;;
      *)
        if [ -z "$agent_name" ]; then
          agent_name="$1"
        elif [ -z "$prompt" ]; then
          prompt="$1"
        else
          _error "Unexpected argument: $1"
          return 1
        fi
        shift
        ;;
    esac
  done

  if [ -z "$agent_name" ] || [ -z "$prompt" ]; then
    _error "Usage: cast dispatch [--managed] <agent> <prompt>"
    printf "  Run: cast dispatch --help\n" >&2
    return 1
  fi

  if [ "$use_managed" -eq 0 ]; then
    _info "Local dispatch: use /orchestrate or the Agent tool in Claude Code"
    return 0
  fi

  # --- Managed dispatch ---
  local shim_script="${CAST_SCRIPTS_DIR}/cast-managed-agent.sh"
  if [ ! -f "$shim_script" ]; then
    shim_script="${CAST_REPO_DIR}/scripts/cast-managed-agent.sh"
  fi
  if [ ! -f "$shim_script" ]; then
    _error "cast-managed-agent.sh not found. Run: bash install.sh"
    return 1
  fi

  # Build shim flags
  local shim_flags=()
  [ "$no_stream" -eq 1 ] && shim_flags+=("--no-stream")

  if [ "$dry_run" -eq 1 ]; then
    # Print the curl command that would be issued for the first API step
    printf "# dry-run: would execute managed dispatch\n"
    printf "curl -s -X POST https://api.anthropic.com/v1/agents"
    printf " \\\\\n  -H 'x-api-key: <ANTHROPIC_API_KEY>'"
    printf " \\\\\n  -H 'anthropic-beta: %s'" "$beta_header"
    printf " \\\\\n  -H 'anthropic-version: 2023-06-01'"
    printf " \\\\\n  -H 'content-type: application/json'"
    if [ "$no_stream" -eq 0 ]; then
      printf " \\\\\n  -H 'Accept: text/event-stream'"
    fi
    printf " \\\\\n  -d '{\"name\":\"%s\",\"model\":\"claude-haiku-4-5\",\"system\":\"...\",\"tools\":[{\"type\":\"agent_toolset_20260401\"}]}'" "$agent_name"
    printf "\n"
    printf "# agent: %s\n# prompt: %s\n# no-stream: %d\n" "$agent_name" "$prompt" "$no_stream"
    return 0
  fi

  _verbose "Dispatching managed agent: $agent_name"
  bash "$shim_script" "$agent_name" "$prompt" "${shim_flags[@]+"${shim_flags[@]}"}"
  local exit_code=$?
  if [ "$exit_code" -eq 0 ]; then
    _success "Managed dispatch complete: $agent_name"
  else
    _error "Managed dispatch failed (exit $exit_code): $agent_name"
  fi
  return "$exit_code"
}

# ── Subcommand: status ───────────────────────────────────────────────────────
_cmd_status() {
  local width=50
  if command -v tput >/dev/null 2>&1; then
    width="$(tput cols 2>/dev/null || echo 50)"
  fi
  if [ "$width" -gt 70 ]; then width=70; fi

  # Budget
  local today_spend=0 week_spend=0
  if [ -f "$CAST_DB_PATH" ] && command -v python3 >/dev/null 2>&1; then
    read -r today_spend week_spend <<< "$(python3 - "$CAST_DB_PATH" <<'PYEOF'
import sys, sqlite3
from datetime import datetime, timedelta, timezone
db = sys.argv[1]
conn = sqlite3.connect(db)
cur = conn.cursor()
today = datetime.now(timezone.utc).strftime('%Y-%m-%d')
week_ago = (datetime.now(timezone.utc)-timedelta(days=7)).strftime('%Y-%m-%d')
cur.execute("SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs WHERE DATE(started_at)=?", (today,))
today_s = cur.fetchone()[0] or 0
cur.execute("SELECT COALESCE(SUM(cost_usd),0) FROM agent_runs WHERE DATE(started_at)>=?", (week_ago,))
week_s = cur.fetchone()[0] or 0
conn.close()
print(f"{today_s:.2f} {week_s:.2f}")
PYEOF
    2>/dev/null || echo "0.00 0.00")"
  fi

  # Memory count + stale count + last verified
  local mem_count=0 mem_stale=0 mem_last_verified="never"
  if [ -f "$CAST_DB_PATH" ] && command -v sqlite3 >/dev/null 2>&1; then
    mem_count="$(sqlite3 "$CAST_DB_PATH" "SELECT COUNT(*) FROM agent_memories;" 2>/dev/null || echo 0)"
    mem_stale="$(sqlite3 "$CAST_DB_PATH" "SELECT COUNT(*) FROM agent_memories WHERE confidence < 0.4;" 2>/dev/null || echo 0)"
    local _mem_lv
    _mem_lv="$(sqlite3 "$CAST_DB_PATH" "SELECT MAX(last_validated_at) FROM agent_memories;" 2>/dev/null || true)"
    [ -n "$_mem_lv" ] && mem_last_verified="$_mem_lv"
  fi

  # Budget — primary: budgets table (global row); secondary: repo cast.json per-dispatch
  local _budget_primary="" _budget_secondary="" _budget_degraded=""

  if [ ! -f "$CAST_DB_PATH" ]; then
    _budget_degraded="cast.db not found — budget data unavailable"
  elif command -v python3 >/dev/null 2>&1; then
    _budget_primary="$(python3 - "$CAST_DB_PATH" "$today_spend" <<'PYEOF'
import sys, sqlite3
db, spend_str = sys.argv[1], sys.argv[2]
try:
    spend = float(spend_str)
except ValueError:
    spend = 0.0
try:
    conn = sqlite3.connect(db, timeout=5)
    cur = conn.cursor()
    cur.execute("SELECT limit_usd, period FROM budgets WHERE scope='global' ORDER BY id DESC LIMIT 1")
    row = cur.fetchone()
    conn.close()
    if row and row[0] is not None:
        limit_usd, period = float(row[0]), str(row[1])
        pct = int(spend / limit_usd * 100) if limit_usd > 0 else 0
        exceeded = " EXCEEDED" if pct >= 100 else ""
        print(f"${spend:.2f} / ${limit_usd:.2f} {period} ({pct}%){exceeded}")
except sqlite3.OperationalError:
    print("__UNREADABLE__")
except Exception:
    print("__UNREADABLE__")
PYEOF
    2>/dev/null || echo "__UNAVAILABLE__")"
    case "$_budget_primary" in
      __UNREADABLE__|__UNAVAILABLE__)
        _budget_degraded="budget table unreadable"
        _budget_primary="" ;;
      *) ;;
    esac
  fi

  # Secondary (or sole source when no global row): repo per-dispatch from cast.json
  local _repo_cast_json="${PWD}/.claude/cast.json"
  if [ -f "$_repo_cast_json" ] && command -v python3 >/dev/null 2>&1; then
    local _repo_limit
    _repo_limit="$(python3 -c "
import json
try:
    with open('$_repo_cast_json') as f:
        cfg = json.load(f)
    limit = cfg.get('budget', {}).get('per_dispatch_limit_usd')
    if limit is not None:
        print(f'\${limit:.2f}')
except Exception:
    pass
" 2>/dev/null || true)"
    [ -n "$_repo_limit" ] && _budget_secondary="${_repo_limit} per dispatch limit"
  fi

  # Agent count
  local agent_count=0
  if [ -d "$CAST_AGENTS_DIR" ]; then
    agent_count="$(ls "$CAST_AGENTS_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')"
  fi

  # Hook count
  local hook_count=0
  local settings_file="${HOME}/.claude/settings.json"
  if [ -f "$settings_file" ]; then
    hook_count="$(python3 -c "
import json
with open('$settings_file') as f:
    cfg = json.load(f)
hooks = cfg.get('hooks', {})
print(sum(len(v) if isinstance(v, list) else 1 for v in hooks.values()))
" 2>/dev/null || echo 0)"
  fi

  # Recent agent runs (last 5)
  local recent_runs=""
  if [ -f "$CAST_DB_PATH" ] && command -v python3 >/dev/null 2>&1; then
    recent_runs="$(python3 - "$CAST_DB_PATH" <<'PYEOF'
import sys, sqlite3
from datetime import datetime, timezone
db = sys.argv[1]
conn = sqlite3.connect(db)
conn.row_factory = sqlite3.Row
cur = conn.cursor()
cur.execute("""
    SELECT agent, status, model, ended_at
    FROM agent_runs
    WHERE agent IS NOT NULL AND agent != '' AND agent != 'unknown'
    ORDER BY id DESC LIMIT 5
""")
rows = cur.fetchall()
conn.close()
now = datetime.now(timezone.utc)
for r in rows:
    ended = r['ended_at'] or ''
    ago = ''
    if ended:
        try:
            t = datetime.fromisoformat(ended.replace('Z','+00:00'))
            diff = int((now - t).total_seconds())
            if diff < 3600:
                ago = f"{diff//60}m ago"
            else:
                ago = f"{diff//3600}h ago"
        except:
            ago = ''
    status_sym = '+' if r['status'] == 'DONE' else ('x' if r['status'] in ('BLOCKED','NEEDS_CONTEXT') else '~')
    model = r['model'] or ''
    print(f"  {status_sym} {(r['agent'] or ''):<22} [{model:<24}] {ago}")
PYEOF
    2>/dev/null || echo "")"
  fi

  # Render dashboard
  local sep
  sep="$(python3 -c "print('=' * $width)" 2>/dev/null || printf '%0.s=' $(seq 1 $width))"

  printf "${C_BOLD}CAST v${CAST_VERSION}${C_RESET}\n"
  printf "%s\n" "$sep"
  printf "Agents      %d in ~/.claude/agents/\n" "$agent_count"
  printf "Hooks       %d active\n" "$hook_count"
  printf "Spend       \$%s today  \$%s this week\n" "$today_spend" "$week_spend"
  if [ -n "$_budget_degraded" ]; then
    printf "Budget      %s\n" "$_budget_degraded"
  elif [ -n "$_budget_primary" ]; then
    printf "Budget      %s\n" "$_budget_primary"
    [ -n "$_budget_secondary" ] && printf "Budget (repo) %s\n" "$_budget_secondary"
  elif [ -n "$_budget_secondary" ]; then
    printf "Budget      %s\n" "$_budget_secondary"
  else
    printf "Budget      not configured (run cast init-repo)\n"
  fi
  if [ "${mem_count:-0}" -gt 0 ]; then
    printf "Memory      %d entries | %d stale (confidence < 0.4) | last verified: %s\n" \
      "$mem_count" "$mem_stale" "$mem_last_verified"
  else
    printf "Memory      not configured\n"
  fi
  printf "%s\n" "$sep"

  if [ -n "$recent_runs" ]; then
    printf "Recent agents (last 5):\n"
    printf "%s\n" "$recent_runs"
  else
    printf "${C_DIM}No recent agent runs recorded.${C_RESET}\n"
  fi
}

# ── Subcommand: agents ───────────────────────────────────────────────────────
_cmd_agents() {
  if [ ! -d "$CAST_AGENTS_DIR" ]; then
    _error "Agents directory not found: $CAST_AGENTS_DIR"
    return 1
  fi

  python3 - "$CAST_AGENTS_DIR" "$CAST_JSON" <<'PYEOF'
import sys, os, json, re

agents_dir = sys.argv[1]
json_out = sys.argv[2] == "1"

agents = []
for fname in sorted(os.listdir(agents_dir)):
    if not fname.endswith('.md'):
        continue
    fpath = os.path.join(agents_dir, fname)
    try:
        with open(fpath, 'r') as f:
            content = f.read()
    except Exception:
        continue

    name = fname.replace('.md', '')
    model = ''
    description = ''

    # Parse YAML frontmatter
    if content.startswith('---'):
        parts = content.split('---', 2)
        if len(parts) >= 3:
            fm = parts[1]
            for line in fm.strip().split('\n'):
                line = line.strip()
                if line.startswith('model:'):
                    model = line.split(':', 1)[1].strip().strip('"').strip("'")
                elif line.startswith('description:'):
                    desc_val = line.split(':', 1)[1].strip()
                    if desc_val == '>':
                        continue
                    description = desc_val.strip('"').strip("'")
                elif not line.startswith(('name:', 'tools:', 'color:', 'memory:', 'maxTurns:', 'effort:')) and description == '' and ':' not in line and line:
                    # Continuation of multiline description
                    description = line.strip()

    agents.append({
        'name': name,
        'model': model or 'sonnet',
        'description': description[:80] if description else '',
    })

if json_out:
    print(json.dumps(agents, indent=2))
    sys.exit(0)

print(f"{'AGENT':<24} {'MODEL':<10} DESCRIPTION")
print("-" * 80)
for a in agents:
    print(f"{a['name']:<24} {a['model']:<10} {a['description']}")
print(f"\n{len(agents)} agents installed")
PYEOF
}

# ── Subcommand: hooks ────────────────────────────────────────────────────────
_cmd_hooks() {
  local settings_file="${HOME}/.claude/settings.json"
  if [ ! -f "$settings_file" ]; then
    _error "settings.json not found at $settings_file"
    return 1
  fi

  python3 - "$settings_file" "$CAST_JSON" <<'PYEOF'
import sys, json, os

settings_file = sys.argv[1]
json_out = sys.argv[2] == "1"

with open(settings_file) as f:
    cfg = json.load(f)

hooks_cfg = cfg.get("hooks", {})
entries = []

for event, hook_list in hooks_cfg.items():
    if not isinstance(hook_list, list):
        hook_list = [hook_list]
    for entry in hook_list:
        if not isinstance(entry, dict):
            continue
        hook_id = entry.get("id", "")
        matcher = entry.get("matcher", "")
        inner_hooks = entry.get("hooks", [])
        for h in inner_hooks:
            if not isinstance(h, dict):
                continue
            htype = h.get("type", "")
            cmd = h.get("command", h.get("url", h.get("prompt", "")))[:60]
            is_async = h.get("async", False)
            timeout = h.get("timeout", "")

            # Check if script exists
            health = "ok"
            if htype == "command" and cmd:
                parts = cmd.split()
                for part in parts:
                    if part in ("bash", "sh", "python3"):
                        continue
                    if part.startswith("-"):
                        continue
                    expanded = os.path.expanduser(part)
                    if "/" in expanded:
                        if not os.path.isfile(expanded):
                            health = "MISSING"
                        break

            entries.append({
                "event": event,
                "id": hook_id,
                "type": htype,
                "command": cmd,
                "async": is_async,
                "timeout": timeout,
                "matcher": matcher,
                "health": health,
            })

if json_out:
    print(json.dumps(entries, indent=2))
    sys.exit(0)

print(f"{'EVENT':<20} {'ID':<24} {'ASYNC':<6} {'HEALTH':<8} COMMAND")
print("-" * 100)
for e in entries:
    async_str = "yes" if e["async"] else "no"
    print(f"{e['event']:<20} {e['id']:<24} {async_str:<6} {e['health']:<8} {e['command']}")
print(f"\n{len(entries)} hook entries across {len(hooks_cfg)} event types")
PYEOF
}

# ── Subcommand: test ────────────────────────────────────────────────────────
_cmd_test() {
  local agent_filter=""
  local record_mode=0
  local ci_mode=0

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --record)   record_mode=1; shift ;;
      --ci)       ci_mode=1; shift ;;
      --help|-h)
        cat <<USAGE
Usage: cast test [agent-name] [--record] [--ci]

  No agent name      Run all contracts in agent-contracts/
  <agent-name>       Run contract for a specific agent
  --record           Record agent output to fixtures (not yet implemented)
  --ci               Suppress ANSI color codes, machine-readable output

Examples:
  cast test              — run all contracts
  cast test commit       — run commit agent contract
  cast test --ci         — CI-safe mode (no colors)
USAGE
        return 0
        ;;
      -*)
        _error "Unknown flag: $1"
        return 1
        ;;
      *)
        if [ -z "$agent_filter" ]; then
          agent_filter="$1"
        fi
        shift
        ;;
    esac
  done

  # Find contract runner script
  local contract_runner="${CAST_SCRIPTS_DIR}/cast-contract-runner.sh"
  if [ ! -f "$contract_runner" ]; then
    contract_runner="${CAST_REPO_DIR}/scripts/cast-contract-runner.sh"
  fi

  if [ ! -f "$contract_runner" ]; then
    _error "cast-contract-runner.sh not found. Run: bash install.sh"
    return 1
  fi

  # Build runner flags
  local runner_flags=""
  [ "$record_mode" -eq 1 ] && runner_flags="--record"

  # Run contract(s)
  if [ -n "$agent_filter" ]; then
    # Single agent contract
    REPO_ROOT="$CAST_REPO_DIR" bash "$contract_runner" "$agent_filter" $runner_flags
    return $?
  else
    # All contracts
    local contracts_dir="${CAST_REPO_DIR}/agent-contracts"
    if [ ! -d "$contracts_dir" ]; then
      _error "agent-contracts/ directory not found"
      return 1
    fi

    local total_passed=0 total_failed=0
    local found_any=0

    if [ -n "$(ls "$contracts_dir"/*.contract.yaml 2>/dev/null || true)" ]; then
      while IFS= read -r contract_file; do
        [ ! -f "$contract_file" ] && continue
        found_any=1

        local agent_name
        agent_name="$(basename "$contract_file" .contract.yaml)"

        _info "Testing $agent_name..."
        if REPO_ROOT="$CAST_REPO_DIR" bash "$contract_runner" "$agent_name" $runner_flags; then
          total_passed=$((total_passed + 1))
        else
          total_failed=$((total_failed + 1))
        fi
      done < <(find "$contracts_dir" -maxdepth 1 -name "*.contract.yaml" -type f 2>/dev/null || true)
    fi

    if [ "$found_any" -eq 0 ]; then
      _warn "No contract files found in agent-contracts/"
      return 0
    fi

    # Summary
    printf "\n%s\n" "$(python3 -c "print('=' * 52)" 2>/dev/null || printf '%0.s=' $(seq 1 52))"
    printf "Contract tests: %d passed, %d failed\n" "$total_passed" "$total_failed"

    if [ "$total_failed" -gt 0 ]; then
      return 1
    else
      return 0
    fi
  fi
}

# ── Subcommand: memory ───────────────────────────────────────────────────────
_cmd_memory() {
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    search)   _memory_search "$@" ;;
    list)     _memory_list "$@" ;;
    verify)   _memory_verify "$@" ;;
    show)     _memory_show "$@" ;;
    delete)   _memory_delete "$@" ;;
    forget)   _memory_forget "$@" ;;
    export)   _memory_export "$@" ;;
    review)   _memory_review "$@" ;;
    dream)    _memory_dream "$@" ;;
    --help|-h)
      cat <<USAGE
Usage: cast memory <subcommand> [args]

  search "<query>"  [--agent <name>] [--project <name>] [--limit 10]
  list              [--agent <name>] [--type feedback|project|user|reference]
  verify            [--agent <name>]  Run staleness sweep
  show <id>                           Print full memory entry
  delete <id>                         Delete a memory entry
  forget <id>
  export
  review            [--list] [--auto-promote]   Pending memory review TUI
  dream             [flags...]                  Run markdown memory consolidation
  dream review      [--project-id <id>]         List pending dream output dirs
  dream promote     --run-id <id> [--force]     Promote a dream output to canonical
USAGE
      ;;
    *)
      _error "Unknown memory subcommand: $subcmd"
      printf "  Use: cast memory search|list|verify|show|delete|forget|export|review|dream\n" >&2
      return 1
      ;;
  esac
}

# ── Subcommand: memory dream ──────────────────────────────────────────────────
_memory_dream() {
  local dream_subcmd="${1:-}"

  case "$dream_subcmd" in
    review)
      shift
      python3 ~/.claude/scripts/cast-memory-dream-review.py "$@"
      ;;
    promote)
      shift
      python3 ~/.claude/scripts/cast-memory-dream-promote.py "$@"
      ;;
    --help|-h)
      python3 ~/.claude/scripts/cast-memory-dream.py --help
      ;;
    *)
      # No recognized sub-subcommand: forward all args to cast-memory-dream.py
      # (handles --dry-run, --project-id, --instructions, etc.)
      python3 ~/.claude/scripts/cast-memory-dream.py "$@"
      ;;
  esac
}

_memory_search() {
  local query=""
  local agent_filter=""
  local project_filter=""
  local limit=10

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --agent)    agent_filter="${2:-}"; shift 2 ;;
      --project)  project_filter="${2:-}"; shift 2 ;;
      --limit)    limit="${2:-10}"; shift 2 ;;
      *)
        if [ -z "$query" ]; then query="$1"; fi
        shift
        ;;
    esac
  done

  if [ -z "$query" ]; then
    _error "Usage: cast memory search \"<query>\" [--agent <name>] [--limit 10]"
    return 1
  fi

  local query_script="${CAST_SCRIPTS_DIR}/cast-memory-query.sh"
  if [ ! -f "$query_script" ]; then
    query_script="${CAST_REPO_DIR}/scripts/cast-memory-query.sh"
  fi

  if [ ! -f "$query_script" ]; then
    _error "cast-memory-query.sh not found"
    return 1
  fi

  local args=("$query" "--limit" "$limit")
  [ -n "$agent_filter" ]   && args+=("--agent"   "$agent_filter")
  [ -n "$project_filter" ] && args+=("--project" "$project_filter")

  local result
  result="$(bash "$query_script" "${args[@]}" 2>/dev/null || echo "[]")"

  if [ "$CAST_JSON" -eq 1 ]; then
    echo "$result"
    return 0
  fi

  python3 - "$result" <<'PYEOF'
import sys, json
try:
    rows = json.loads(sys.argv[1])
except Exception:
    rows = []
if not rows:
    print("No memories found.")
    sys.exit(0)
for r in rows:
    score = f"  [score:{r['score']:.2f}]" if 'score' in r else ""
    print(f"[{r['id']}] {r['agent']} / {r['type']} — {r['name']}{score}")
    content = (r['content'] or '')[:200]
    print(f"  {content}")
    print()
PYEOF
}

_memory_list() {
  _require_db

  local agent_filter=""
  local type_filter=""

  while [ "${#}" -gt 0 ]; do
    case "$1" in
      --agent) agent_filter="${2:-}"; shift 2 ;;
      --type)  type_filter="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done

  python3 - "$CAST_DB_PATH" "$agent_filter" "$type_filter" "$CAST_JSON" <<'PYEOF'
import sys, sqlite3, json

db_path, agent_f, type_f, json_mode = sys.argv[1:5]
json_out = json_mode == "1"

conn = sqlite3.connect(db_path)
conn.row_factory = sqlite3.Row
cur = conn.cursor()

conditions = []
params = []
if agent_f:
    conditions.append("agent = ?")
    params.append(agent_f)
if type_f:
    conditions.append("type = ?")
    params.append(type_f)

where = ("WHERE " + " AND ".join(conditions)) if conditions else ""
cur.execute(
    f"SELECT id, agent, project, type, name, description, created_at FROM agent_memories {where} ORDER BY agent, type, created_at",
    params
)
rows = [dict(r) for r in cur.fetchall()]
conn.close()

if json_out:
    print(json.dumps(rows, indent=2))
    sys.exit(0)

if not rows:
    print("No memories found.")
    sys.exit(0)

print(f"{'ID':<6} {'AGENT':<22} {'TYPE':<12} {'NAME':<30} CREATED")
print("-" * 90)
for r in rows:
    print(f"{r['id']:<6} {(r['agent'] or ''):<22} {(r['type'] or ''):<12} {(r['name'] or '')[:30]:<30} {(r['created_at'] or '')[:19]}")
PYEOF
}

_memory_forget() {
  _require_db
  local memory_id="${1:-}"
  if [ -z "$memory_id" ]; then
    _error "Usage: cast memory forget <memory-id>"
    return 1
  fi

  local rows_affected
  rows_affected="$(python3 - "$CAST_DB_PATH" "$memory_id" <<'PYEOF'
import sys, sqlite3
db_path, mem_id = sys.argv[1], sys.argv[2]
conn = sqlite3.connect(db_path)
cur = conn.cursor()
cur.execute("DELETE FROM agent_memories WHERE id=?", (mem_id,))
conn.commit()
print(cur.rowcount)
conn.close()
PYEOF
  )"

  if [ "${rows_affected:-0}" -eq 0 ]; then
    _warn "Memory $memory_id not found"
  else
    if [ "$CAST_JSON" -eq 1 ]; then
      printf '{"status":"deleted","id":"%s"}\n' "$memory_id"
    else
      _success "Memory $memory_id deleted"
    fi
  fi
}

_memory_export() {
  _require_db
  python3 - "$CAST_DB_PATH" <<'PYEOF'
import sys, sqlite3, json

db_path = sys.argv[1]
conn = sqlite3.connect(db_path)
conn.row_factory = sqlite3.Row
cur = conn.cursor()
cur.execute("SELECT id, agent, project, type, name, description, content, created_at, updated_at FROM agent_memories ORDER BY id")
rows = [dict(r) for r in cur.fetchall()]
conn.close()
print(json.dumps(rows, indent=2))
PYEOF
}

