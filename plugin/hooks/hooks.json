{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-plugin-bootstrap.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-session-start-hook.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-time-context",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-time-context-hook.sh\"",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-session-start-journal",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-session-start-journal.sh\"",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-session-start-health",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-session-start-health.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-user-prompt-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-tool-failure-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-hook.sh\"",
            "if": "Write|Edit|Agent|Bash",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-audit-hook.sh\" --mode post",
            "timeout": 3,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:3001/api/hook-events",
            "method": "POST",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-instructions-loaded-hook.sh\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-audit-hook.sh\" --mode pre",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool-guard.sh\"",
            "if": "Bash(git *)",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-command-guard",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-command-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-headless-guard.sh\"",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-write-guards",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/write-guards.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate whether this file change could expose secrets, weaken authentication, or leak sensitive data. If the change is dangerous, respond with BLOCK and explain why. If safe, respond with ALLOW.",
            "if": "Write(**/.env*|**/auth/**|**/credentials*|**/secrets*)"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate whether this file change could expose secrets, weaken authentication, or leak sensitive data. If the change is dangerous, respond with BLOCK and explain why. If safe, respond with ALLOW.",
            "if": "Edit(**/.env*|**/auth/**|**/credentials*|**/secrets*)"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "id": "cast-cwd-changed",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-cwdchanged-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "id": "cast-file-changed",
        "matcher": ".envrc|.env|.cast|cast.json",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-filechanged-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "id": "cast-precompact-guard",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-precompact-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "id": "cast-precompact-memory-save",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-precompact-memory-save.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "cast-journal-session-end",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-journal-session-end.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-session-end.sh\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-subagent-start-hook.sh\"",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "id": "cast-subagent-stop",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-subagent-stop-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "id": "cast-budget-alert",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-budget-alert.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "id": "cast-response-completeness",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-response-completeness-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "id": "cast-subagent-worktree-check",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-subagent-worktree-check.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-stop-failure-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-post-compact-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Context was automatically compacted. Briefly let the user know this happened, summarize the current task state, and continue where you left off."
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/cast-task-created-hook.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}