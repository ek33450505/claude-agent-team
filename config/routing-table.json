{
  "_comment": "Soft routing patterns. Maps keyword patterns to agent names for dispatch suggestions. Patterns are matched case-insensitively against user prompts.",
  "routes": [
    {
      "agent": "security",
      "patterns": ["auth", "authentication", "authorization", "api key", "token", "oauth", "jwt", "credential", "secret", "permission", "access control"],
      "model": "sonnet",
      "confidence": "soft",
      "post_chain": ["security"]
    }
  ],
  "patterns": [
    { "keywords": ["migrate", "migration", "schema", "alter table", "create table"], "agent": "migration-reviewer" },
    { "keywords": ["api", "contract", "endpoint", "route", "breaking change", "openapi"], "agent": "api-contract" },
    { "keywords": ["dependency", "audit", "cve", "vulnerability", "npm audit", "pip audit"], "agent": "dep-auditor" },
    { "keywords": ["release", "changelog", "version", "release notes"], "agent": "release-notes" },
    { "keywords": ["benchmark", "performance", "regression", "perf", "bisect"], "agent": "perf-sentinel" },
    { "keywords": ["email", "draft email", "compose email", "reply email", "gmail", "portfolio sync", "readme stats", "portfolio update", "showcase", "readme", "docs", "documentation", "doc update"], "agent": "docs" },
    { "keywords": ["obsidian", "vault", "organize", "curator", "orphan notes", "moc"], "agent": "docs" },
    { "keywords": ["eval", "evals", "benchmark fixture", "prompt regression", "agent eval"], "agent": "eval-writer" },
    { "keywords": ["pr review", "pull request review", "pr open", "holistic review"], "agent": "pr-reviewer" }
  ]
}
