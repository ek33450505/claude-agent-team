#compdef cast
# zsh completion for cast CLI
# Install: copy to a directory in $fpath (e.g. ~/.zsh/completions/_cast)
# Then add to ~/.zshrc:
#   fpath=(~/.zsh/completions $fpath)
#   autoload -U compinit && compinit

_cast_agents() {
  local agents_dir="${HOME}/.claude/agents"
  if [[ -d "$agents_dir" ]]; then
    local -a agents
    agents=("${agents_dir}"/*.md(:t:r))
    _describe 'agent' agents
  fi
}

_cast_memory_types() {
  local -a types
  types=(feedback project user reference)
  _describe 'type' types
}

_cast_memory() {
  local curcontext="$curcontext" state line
  local -a subcommands
  # BEGIN GENERATED MEMORY SUBCOMMANDS (zsh) — do not edit by hand; run scripts/gen-completions.sh
  subcommands=(
    'search:Search memories by query'
    'list:List all memories'
    'verify:Run staleness sweep'
    'show:Print full memory entry'
    'delete:Delete a memory entry'
    'forget:Delete a memory by ID'
    'export:Export all memories as JSON'
    'review:Pending memory review TUI'
    'dream:Run markdown memory consolidation'
  )
  # END GENERATED MEMORY SUBCOMMANDS (zsh)
  _arguments \
    '1:subcommand:->subcommand' \
    '*::arg:->args'

  case "$state" in
    subcommand)
      _describe 'subcommand' subcommands
      ;;
    args)
      case "$line[1]" in
        search)
          _arguments \
            '1:query:()' \
            '--agent[Filter by agent]:agent:_cast_agents' \
            '--project[Filter by project]:project:()' \
            '--limit[Maximum results]:limit:()'
          ;;
        list)
          _arguments \
            '--agent[Filter by agent]:agent:_cast_agents' \
            '--type[Filter by type]:type:_cast_memory_types'
          ;;
        forget)
          _arguments '1:memory-id:()'
          ;;
      esac
      ;;
  esac
}

_cast_budget() {
  local curcontext="$curcontext" state line
  _arguments \
    '--week[Show last 7 days breakdown]' \
    '--project[Show project spend]:project:()' \
    '1:subcommand:(set)' \
    '*::arg:->args'

  case "$state" in
    args)
      case "$line[1]" in
        set)
          _arguments \
            '--global[Set global daily budget]:amount:()' \
            '--session[Set per-session budget]:amount:()'
          ;;
      esac
      ;;
  esac
}

_cast() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '--json[Machine-readable JSON output]' \
    '--quiet[Suppress informational output]' \
    '--verbose[Show debug details]' \
    '--help[Show help]' \
    '--version[Show version]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args'

  case "$state" in
    subcommand)
      local -a subcommands
      # Bare names only (no name:description pairs): bin/cast --help formats
      # descriptions inconsistently (args interleaved, variable spacing), so
      # parsing them would reintroduce exactly the drift this region exists
      # to remove. _describe works fine against a plain array.
      # BEGIN GENERATED SUBCOMMANDS (zsh) — do not edit by hand; run scripts/gen-completions.sh
      subcommands=(agents ask backup batch budget cheap ci-local clean cost dash db-contract dispatch doctor eval exec feature files hooks incidents init-repo install-completions integrity ledger mcp memory migrate new-agent parallel plan-doctor predict provenance restore review routines stack status test tidy upgrade-check verify-chain)
      # END GENERATED SUBCOMMANDS (zsh)
      _describe 'subcommand' subcommands
      ;;
    args)
      case "$line[1]" in
        memory)   _cast_memory ;;
        budget)   _cast_budget ;;
      esac
      ;;
  esac
}

_cast "$@"
