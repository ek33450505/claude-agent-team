{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      "dist"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/cast-statusline.sh 2>/dev/null || echo 'CAST ready'"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "*.googleapis.com",
        "api.anthropic.com"
      ],
      "allowLocalBinding": true,
      "allowManagedDomainsOnly": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh/id_*",
        "~/.gnupg",
        "~/.claude/cast.db",
        "~/.claude/history.jsonl",
        "~/.claude/logs/**",
        "~/.claude/routing-log.jsonl"
      ]
    },
    "excludedCommands": [
      "git",
      "docker",
      "bq",
      "osascript"
    ],
    "credentials": {
      "files": [
        {"path": "~/.aws/credentials", "mode": "deny"},
        {"path": "~/.aws/config", "mode": "deny"},
        {"path": "~/.ssh", "mode": "deny"},
        {"path": "~/.gnupg", "mode": "deny"},
        {"path": "~/.kube/config", "mode": "deny"},
        {"path": "~/.netrc", "mode": "deny"}
      ],
      "envVars": [
        {"name": "GITHUB_TOKEN", "mode": "deny"},
        {"name": "GH_TOKEN", "mode": "deny"},
        {"name": "NPM_TOKEN", "mode": "deny"},
        {"name": "AWS_ACCESS_KEY_ID", "mode": "deny"},
        {"name": "AWS_SECRET_ACCESS_KEY", "mode": "deny"},
        {"name": "OPENAI_API_KEY", "mode": "deny"}
      ]
    }
  },
  "autoUpdatesChannel": "stable",
  "plansDirectory": "~/.claude/plans/",
  "_permissions_warning": "REVIEW CAREFULLY: Bash/Write/Edit let Claude act without asking. Remove any you're not comfortable with.",
  "_routing_note": "Model routing: haiku for commit/push/code-reviewer/test-runner. opus is the default (set in 16-model-defaults.json). Set CLAUDE_CODE_SUBAGENT_MODEL to override globally. Effort levels: see agent frontmatter.",
  "teammateMode": "in-process"
}
