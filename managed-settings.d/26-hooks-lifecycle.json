{
  "hooks": {
    "PreCompact": [
      {
        "id": "cast-precompact-guard",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-precompact-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "id": "cast-precompact-memory-save",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-precompact-memory-save.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
