{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-audit-hook.sh --mode post",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-audit-hook.sh --mode pre",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-pretool-dispatch",
        "matcher": "mcp__.*|WebFetch|WebSearch|Bash|Read|Write|Edit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/cast-pretool-dispatch.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-headless-guard.sh",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-write-guards",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/write-guards.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
