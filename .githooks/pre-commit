#!/usr/bin/env bash
# CAST pre-commit hook: regression lints + sync README stats
# Blocks on all lint failures (Lints 1–3 + hook-contract validation).
# One-time bypass: prefix the commit command with CAST_SKIP_LINTS=1 to skip
# Lints 1 and 2 (cold-start counter and SQL injection). This does NOT bypass
# the orphan-script lint or hook-contract validation.
# Self-lints bypass: CAST_SKIP_SELF_LINTS=1 skips the 4 self-lint gates
# (byte-budget, hook-wiring, agent-roster, agent-boilerplate). For one-time
# emergencies only — address violations before the next merge.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Lint 1: Python cold-start counter — fail if >2 inline python3 -c calls per script
# Grandfathered files: scripts in .githooks/cold-start-baseline.txt are permitted to keep
# their existing count; they only fail if the count GROWS (regression).
# New files are subject to the strict >2 limit.
_lint_python_cold_starts() {
  local failed=0
  local script baseline_file
  baseline_file=".githooks/cold-start-baseline.txt"

  for script in scripts/*.sh; do
    [[ -f "$script" ]] || continue
    local count
    count=$(grep -E 'python3 -c|python3 <<|python3 - <<' "$script" 2>/dev/null | wc -l | tr -d ' ')

    # Check if this script is in the baseline
    local baseline_line=""
    if [[ -f "$baseline_file" ]]; then
      baseline_line=$(grep "^${script}:" "$baseline_file" 2>/dev/null || echo "")
    fi

    if [[ -n "$baseline_line" ]]; then
      # File is grandfathered: only fail if count INCREASED
      local baseline=""
      baseline=$(echo "$baseline_line" | cut -d: -f2 | tr -d ' ' || echo "")
      if [[ -n "$baseline" && $count -gt $baseline ]]; then
        echo "ERROR [lint-cold-starts]: $script has $count python3 -c calls (baseline: $baseline). Consolidate into a .py file to reduce cold-start overhead."
        failed=1
      fi
    else
      # New file: fail if >2
      if [[ $count -gt 2 ]]; then
        echo "ERROR [lint-cold-starts]: $script has $count python3 -c calls (max 2 for new files). Consolidate into a .py file."
        failed=1
      fi
    fi
  done

  # Print informational notice (non-blocking)
  local baseline_count=0
  if [[ -f "$baseline_file" ]]; then
    baseline_count=$(wc -l < "$baseline_file" | tr -d ' ')
  fi
  if [[ $baseline_count -gt 0 ]]; then
    echo "[CAST] NOTE: .githooks/cold-start-baseline.txt grandfathers $baseline_count files with pre-existing violations. These should be consolidated into .py files as capacity allows." >&2
  fi

  return $failed
}

# Lint 2: SQL injection detector — flag scripts that interpolate env vars into sqlite3 strings.
# Covers: sqlite3 and cast_sqlite (wrapper), braced ${var} and bare $var interpolation,
# inline SQL strings, unquoted heredoc bodies, and both scripts/*.sh and bin/cast.
# Guard: interpolation wrapped in SQL single quotes ('$var' or '${var}') is considered safe.
# Per-invocation judgment: each sqlite3/cast_sqlite call is evaluated independently.
_lint_sql_injection() {
  local failed=0
  local file

  # Build the list of files to scan: scripts/*.sh + bin/cast
  local scan_files=()
  for f in scripts/*.sh; do
    [[ -f "$f" ]] && scan_files+=("$f")
  done
  [[ -f "bin/cast" ]] && scan_files+=("bin/cast")

  for file in "${scan_files[@]}"; do
    # Use awk for stateful multi-line scanning.
    # Rules:
    #   1. Inline SQL: a (sqlite3|cast_sqlite) line has a double-quoted SQL argument
    #      containing $var or ${var} outside SQL single-quoted context.
    #      The db-path argument ("$DB" etc.) is skipped to avoid false positives.
    #   2. Unquoted heredoc: a (sqlite3|cast_sqlite) call opens an unquoted heredoc
    #      (<<MARKER, not <<'MARKER'). Within that body, $var or ${var} outside SQL
    #      single-quoted context is flagged.
    # A $ is "inside SQL single quotes" when scanning from the SQL start position,
    # the count of single-quote chars seen so far is odd.
    local violations
    violations=$(awk '
      # Returns position of closing " of a double-quoted string starting at open_pos.
      function find_dq_close(line, open_pos,    i, len) {
        len = length(line)
        for (i = open_pos + 1; i <= len; i++) {
          if (substr(line, i, 1) == "\"") return i
        }
        return 0
      }

      # Returns 1 if line[start_col..end_col] contains $var or ${var} outside SQL
      # single-quoted context. Single-quote depth is tracked from start_col onward.
      function has_unsafe_dollar(line, start_col, end_col,    i, c, sq_count, nc) {
        sq_count = 0
        for (i = start_col; i <= end_col; i++) {
          c = substr(line, i, 1)
          if (c == "'"'"'") {
            sq_count++
          } else if (c == "$") {
            if (sq_count % 2 == 1) continue  # inside SQL single-quoted string — safe
            nc = substr(line, i+1, 1)
            if (nc ~ /[a-zA-Z_{]/) return 1   # bare $var or ${var} outside SQL quotes
          }
        }
        return 0
      }

      # Find the SQL argument in an inline sqlite3/cast_sqlite call from cmd_end.
      # Skips db-path args ("$DB", "${DB_PATH}", "~/path") and dot-cmd args (".timeout").
      # Returns the opening " position of the SQL argument, or 0 if not found.
      # When skipping an arg, the entire "..." group is consumed to avoid mis-parsing.
      function find_sql_arg(line, cmd_end,    i, c, len, in_dq, arg_start, arg_char, skip_arg) {
        len = length(line)
        in_dq = 0; skip_arg = 0; i = cmd_end
        while (i <= len) {
          c = substr(line, i, 1)
          if (!in_dq) {
            if (c == "\"") {
              in_dq = 1; arg_start = i
              arg_char = substr(line, i+1, 1)
              # Determine if this arg should be skipped (db path, flag value, indirection)
              if (arg_char ~ /[$~\/]/ || arg_char == ".") {
                skip_arg = 1  # consume this "..." group but do not return it
              } else {
                skip_arg = 0  # candidate SQL arg
              }
            }
          } else {
            if (c == "\"") {
              in_dq = 0
              if (!skip_arg) return arg_start  # this was a SQL arg
              # else: continue scanning for the next "..." group
            }
          }
          i++
        }
        return 0
      }

      BEGIN { in_heredoc = 0; heredoc_marker = ""; heredoc_safe = 0; lineno = 0 }

      {
        lineno++
        line = $0

        # --- Heredoc body processing ---
        if (in_heredoc) {
          stripped = line
          gsub(/^[[:space:]]+/, "", stripped); gsub(/[[:space:]]+$/, "", stripped)
          if (stripped == heredoc_marker) { in_heredoc = 0; heredoc_marker = ""; heredoc_safe = 0; next }
          if (!heredoc_safe) {
            if (has_unsafe_dollar(line, 1, length(line))) {
              print FILENAME ":" lineno ": heredoc body has unquoted $-interpolation outside SQL single quotes: " line
            }
          }
          next
        }

        # --- Only process lines with a sqlite3 or cast_sqlite invocation ---
        if (line !~ /(sqlite3|cast_sqlite)/) next

        # Skip existence checks (command -v sqlite3 / if sqlite3 ...)
        if (line ~ /command -v sqlite3/) next

        # --- Detect heredoc opening ---
        if (match(line, /<<[[:space:]]*/)) {
          heredoc_start = RSTART + RLENGTH
          marker_candidate = substr(line, heredoc_start)
          gsub(/[[:space:]].*$/, "", marker_candidate)
          if (marker_candidate != "") {
            if (marker_candidate ~ /^'"'"'.*'"'"'$/ || marker_candidate ~ /^".*"$/) {
              in_heredoc = 1; m = marker_candidate; gsub(/['"'"'"]/, "", m)
              heredoc_marker = m; heredoc_safe = 1
            } else {
              in_heredoc = 1; heredoc_marker = marker_candidate; heredoc_safe = 0
            }
          }
          next
        }

        # --- Inline SQL check ---
        if (match(line, /(sqlite3|cast_sqlite)/)) {
          cmd_end = RSTART + RLENGTH
          sql_pos = find_sql_arg(line, cmd_end)
          if (sql_pos == 0) next
          sql_end = find_dq_close(line, sql_pos)
          if (sql_end == 0) sql_end = length(line)
          if (has_unsafe_dollar(line, sql_pos + 1, sql_end - 1)) {
            print FILENAME ":" lineno ": inline SQL has unquoted $-interpolation outside SQL single quotes: " line
          }
        }
      }
    ' "$file" 2>/dev/null)

    if [[ -n "$violations" ]]; then
      echo "ERROR [lint-sql-injection]: $file has potential SQL injection:"
      while IFS= read -r v; do
        echo "  $v"
      done <<< "$violations"
      failed=1
    fi
  done
  return $failed
}

# Lint 3: Orphan script detector — fail if a script is referenced in settings.json but missing from scripts/
_lint_orphan_scripts() {
  python3 scripts/cast-lint-orphan-scripts.py
}

# Lint 5 (self): Byte budget — fail if rules-core/ cumulative size exceeds budget
_lint_byte_budget() {
  bash scripts/cast-lint-byte-budget.sh
}

# Lint 6 (self): Hook wiring — fail on duplicate hook wiring in settings/fragments
_lint_hook_wiring() {
  python3 scripts/cast-lint-hook-wiring.py
}

# Lint 7 (self): Agent roster — fail if docs/agents/AGENT-ROSTER.md diverges from agents/core/
_lint_agent_roster() {
  python3 scripts/cast-lint-agent-roster.py
}

# Lint 8 (self): Agent boilerplate — fail if any agent def inlines verbatim skill prose
_lint_agent_boilerplate() {
  bash scripts/cast-lint-agent-boilerplate.sh
}

# Lint 9 (self): Blast-radius guard — any bare rm -rf / shutil.rmtree in scripts/ is a violation
_lint_blast_radius() {
  bash scripts/blast-radius-lint.sh
}

# --- Hook contract validation ---
# Exit code semantics: 0=all pass, 1=warn-only (benign), 2=errors found.
# Only block (exit 1) when the validator reports ERRORS (exit 2). Warns let the commit proceed.
if git diff --cached --name-only | grep -qE '^(settings\.json|managed-settings\.d/.*\.json)$'; then
    if [[ -x scripts/cast-validate-hook-contracts.sh ]]; then
        validate_exit=0
        bash scripts/cast-validate-hook-contracts.sh --source || validate_exit=$?
        if [[ $validate_exit -eq 2 ]]; then
            echo "[pre-commit] Hook contract validator found ERRORS — see output above. Use CAST_SKIP_HOOK_VALIDATE=1 to bypass." >&2
            [[ "${CAST_SKIP_HOOK_VALIDATE:-0}" != "1" ]] && exit 1
        elif [[ $validate_exit -eq 1 ]]; then
            echo "[pre-commit] Hook contract validator found warnings (non-blocking) — see output above." >&2
        fi
    fi
fi

# Run all lints
echo "[CAST pre-commit] Running regression lints..."

if [[ "${CAST_SKIP_LINTS:-0}" == "1" ]]; then
  echo "[CAST pre-commit] WARNING: CAST_SKIP_LINTS=1 — Lints 1 (cold-start) and 2 (SQL injection) skipped. This bypass is for one-time emergencies only." >&2
else
  lint_failed=0
  _lint_python_cold_starts || lint_failed=1
  _lint_sql_injection || lint_failed=1
  if [[ "$lint_failed" -ne 0 ]]; then
    echo ""
    echo "ERROR [pre-commit]: One or more regression lints failed. See above for details."
    echo "  To bypass for a one-time emergency: CAST_SKIP_LINTS=1 git commit ..."
    echo "  CAST_SKIP_LINTS is NOT a permanent fix — address the lint violations."
    exit 1
  fi
fi

_lint_orphan_scripts || {
  echo "ERROR: Orphan script check failed. See above."
  exit 1
}

# Lint 4: utcnow regression guard — fail if any staged .py or .sh file introduces datetime.utcnow()
# Unit 3 swept all utcnow() calls; this lint prevents re-introduction.
# Fix: replace datetime.utcnow() with datetime.now(timezone.utc)
_lint_utcnow() {
  local matches
  matches=$(git diff --cached -U0 -- '*.py' '*.sh' | grep '^+' | grep -E 'datetime\.utcnow\(|\.utcnow\(\)' || true)
  if [[ -n "$matches" ]]; then
    echo "ERROR [lint-utcnow]: staged change introduces datetime.utcnow() (deprecated naive UTC)."
    echo "  Fix: replace with datetime.now(timezone.utc)"
    echo "  Matches:"
    echo "$matches" | sed 's/^/    /'
    return 1
  fi
  return 0
}
_lint_utcnow || {
  echo "ERROR [pre-commit]: utcnow lint failed. See above."
  exit 1
}

# Self-lints: byte-budget, hook-wiring, agent-roster, agent-boilerplate
if [[ "${CAST_SKIP_SELF_LINTS:-0}" == "1" ]]; then
  echo "[CAST pre-commit] WARNING: CAST_SKIP_SELF_LINTS=1 — self-lints (byte-budget, hook-wiring, agent-roster, agent-boilerplate) skipped. This bypass is for one-time emergencies only." >&2
else
  self_lint_failed=0
  _lint_byte_budget       || self_lint_failed=1
  _lint_hook_wiring       || self_lint_failed=1
  _lint_agent_roster      || self_lint_failed=1
  _lint_agent_boilerplate || self_lint_failed=1
  _lint_blast_radius      || self_lint_failed=1
  if [[ "$self_lint_failed" -ne 0 ]]; then
    echo ""
    echo "ERROR [pre-commit]: One or more self-lints failed. See above for details."
    echo "  To bypass for a one-time emergency: CAST_SKIP_SELF_LINTS=1 git commit ..."
    echo "  CAST_SKIP_SELF_LINTS is NOT a permanent fix — address the lint violations."
    exit 1
  fi
fi

# Keep canonical cast-stats.json in sync with derived stats (git ls-files based → CI-consistent).
# Only stages when a real stat field changed (--check ignores the volatile `updated` field),
# so unrelated commits never churn the file. Never blocks the commit.
if command -v jq >/dev/null 2>&1 && [[ -x scripts/gen-cast-stats.sh ]]; then
  if ! bash scripts/gen-cast-stats.sh --check >/dev/null 2>&1; then
    bash scripts/gen-cast-stats.sh >/dev/null 2>&1 || true
    git add cast-stats.json 2>/dev/null || true
    echo "[CAST pre-commit] refreshed cast-stats.json (stats changed)"
  fi
fi

# Keep ecosystem-versions.json in sync with local sibling repos.
# Runs in --local mode (reads sibling repos under ~/Projects/personal/); if siblings are absent
# the script reuses committed values and --check passes — safe no-op. Never blocks the commit.
if command -v jq >/dev/null 2>&1 && [[ -x scripts/gen-ecosystem-versions.sh ]]; then
  if ! bash scripts/gen-ecosystem-versions.sh --check >/dev/null 2>&1; then
    bash scripts/gen-ecosystem-versions.sh >/dev/null 2>&1 || true
    git add ecosystem-versions.json 2>/dev/null || true
    echo "[CAST pre-commit] refreshed ecosystem-versions.json"
  fi
fi

# NOTE: README badge updates are now handled by the post-merge job (readme-badge-sync.yml)
# This ensures badges are always in sync on main without blocking PRs.

# Plugin-drift guard — only runs when bundled-source files are staged.
# Catches the "passes locally (disk-vs-disk), fails in CI (committed-vs-regen)" trap.
# Bypass: CAST_SKIP_PLUGIN_DRIFT=1 git commit ... (one-time emergency only)
if git diff --cached --name-only | grep -qE '^(agents/core/|skills/|commands/|scripts/|managed-settings\.d/)'; then
    if [[ "${CAST_SKIP_PLUGIN_DRIFT:-0}" != "1" ]]; then
        drift_exit=0
        bash scripts/check-plugin-drift.sh || drift_exit=$?
        if [[ $drift_exit -ne 0 ]]; then
            echo "" >&2
            echo "ERROR [pre-commit]: plugin/ is out of sync with bundled source (plugin drift detected)." >&2
            echo "  Regenerate and stage plugin/ before committing:" >&2
            # shellcheck disable=SC2016  # single quotes intentional: literal command for user to paste
            echo '    bash scripts/gen-plugin.sh "$(git rev-parse --show-toplevel)/plugin" && git add plugin/' >&2
            echo "  To bypass for a one-time emergency: CAST_SKIP_PLUGIN_DRIFT=1 git commit ..." >&2
            exit 1
        fi
    else
        echo "[CAST pre-commit] WARNING: CAST_SKIP_PLUGIN_DRIFT=1 — plugin-drift guard skipped. Regenerate plugin/ before the next merge." >&2
    fi
fi

exit 0
