#!/usr/bin/env bash
# CAST post-commit hook — D5 provenance fix
#
# Records commit provenance (SHA → session) deterministically on every
# in-session commit. This is the symmetric counterpart to the pre-push D5
# gate: if the commit agent's step-8 recording is skipped under truncation
# or outage, this hook fills the gap so the gate never false-blocks.
#
# Fires ONLY when CLAUDECODE=1 (in-session). Human terminal commits
# (CLAUDECODE unset) are silently skipped — no side effects.
#
# NO CLAUDE_SUBPROCESS guard: this hook MUST fire inside subagent shells
# (the commit agent is a subagent — that is precisely where the miss occurs).
#
# Logs to: ~/.claude/logs/post-commit-provenance.log
#
# Escape hatch: CAST_SKIP_POST_COMMIT_PROVENANCE=1 git commit -m "..."

set -euo pipefail

LOG_DIR="$HOME/.claude/logs"
LOG_FILE="$LOG_DIR/post-commit-provenance.log"
TIMESTAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

_log() {
	mkdir -p "$LOG_DIR" 2>/dev/null || true
	echo "[$TIMESTAMP] $*" >>"$LOG_FILE"
}

# Escape hatch
if [[ "${CAST_SKIP_POST_COMMIT_PROVENANCE:-0}" == "1" ]]; then
	_log "skipped (escape hatch: CAST_SKIP_POST_COMMIT_PROVENANCE=1)"
	exit 0
fi

# Gate: only record in-session (CLAUDECODE=1). Human terminal → silent skip.
if [[ "${CLAUDECODE:-0}" != "1" ]]; then
	exit 0
fi

# Shared hook contract (identical text in every installed git hook): the hook is an INSTALLED,
# agent-unwritable copy in ~/.claude/githooks/ and calls ONLY installed ~/.claude/scripts/*; the
# repo is passed as data (CAST_REPO_ROOT). There is no repo-copy fallback.
CAST_SCRIPTS="${HOME}/.claude/scripts"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
export CAST_REPO_ROOT="$REPO_ROOT"
_cast_installed() {  # path of an installed script, or fail closed
  if [[ -f "$CAST_SCRIPTS/$1" && ! -L "$CAST_SCRIPTS/$1" ]]; then printf '%s\n' "$CAST_SCRIPTS/$1"; return 0; fi
  echo "[CAST post-commit] installed $1 missing — run: bash install.sh" >&2; return 1
}

# Capture the full 40-char SHA
SHA="$(git rev-parse HEAD 2>/dev/null)" || {
	_log "ERROR: git rev-parse HEAD failed — skipping provenance record"
	exit 0
}

# Recorder: informational step — a missing installed recorder is logged and skipped (provenance
# is best-effort and must never block a commit), but the repo copy is NEVER used as a fallback.
RECORDER="$(_cast_installed cast-commit-provenance.py)" || {
	_log "installed recorder absent or a symlink — skipping provenance record for $SHA (run: bash install.sh)"
	exit 0
}

# Record provenance — best-effort, never block the commit
if python3 -I "$RECORDER" record "$SHA" 2>>"$LOG_FILE"; then
	_log "recorded provenance for $SHA (recorder: $RECORDER)"
else
	_rc=$?
	_log "recorder exited $_rc for $SHA — non-fatal, commit proceeds"
fi

# post-commit exit code is advisory — never break the commit
exit 0
