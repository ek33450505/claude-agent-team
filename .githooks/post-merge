#!/usr/bin/env bash
# CAST post-merge hook
#
# Fires after `git merge` and the merge half of `git pull` (NOT after rebase).
# Gates `install.sh` on actual CAST source changes (agents/, scripts/, bin/, rules-core/, .githooks/).
# If none of those directories changed, the hook exits silently.
#
# Logs to: ~/.claude/logs/auto-install.log
#
# Escape hatch: CAST_SKIP_POST_MERGE_INSTALL=1 git pull
#
# Testability seam: set CAST_POST_MERGE_INSTALL_CMD to override the install
# command. The hook evaluates this variable as a shell command string via
# bash -c, so keep it simple (no shell metacharacters in the value).
# Example: CAST_POST_MERGE_INSTALL_CMD='touch /tmp/installed.marker'

# This is an INSTALLED, agent-unwritable copy (~/.claude/githooks/, deployed by install.sh) and it
# calls ONLY installed ~/.claude/scripts/*; the repo is passed as data (CAST_REPO_ROOT).
# ACCEPTED RESIDUAL: the one step below that runs repo code is `bash "$REPO_ROOT/install.sh"` —
# that IS the deploy step, by design: it executes the install.sh just pulled/merged (install.sh
# itself refuses to run on a dirty tree in the paths it deploys). A merged malicious install.sh
# therefore runs here with the user's privileges; the guard is review of what is merged.

set -euo pipefail

CAST_SCRIPTS="${HOME}/.claude/scripts"
REPO_ROOT="$(git rev-parse --show-toplevel)"   # rev-parse is probe-verified not to run config programs
cd "$REPO_ROOT"
export CAST_REPO_ROOT="$REPO_ROOT"
_cast_installed() {  # path of an installed script, or fail closed
  if [[ -f "$CAST_SCRIPTS/$1" && ! -L "$CAST_SCRIPTS/$1" ]]; then printf '%s\n' "$CAST_SCRIPTS/$1"; return 0; fi
  echo "[CAST post-merge] installed $1 missing — run: bash install.sh" >&2; return 1
}

LOG_DIR="$HOME/.claude/logs"
LOG_FILE="$LOG_DIR/auto-install.log"
TIMESTAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

_log() {
  mkdir -p "$LOG_DIR"
  echo "[$TIMESTAMP] $*" >> "$LOG_FILE"
}

# Escape hatch
if [[ "${CAST_SKIP_POST_MERGE_INSTALL:-0}" == "1" ]]; then
  _log "skipped (escape hatch: CAST_SKIP_POST_MERGE_INSTALL=1)"
  exit 0
fi

# Repo git calls go through cast_git_safe (config-exec paths neutralised) from the INSTALLED lib.
# post-merge cannot block the merge, so "fail closed" = do nothing further, never use a repo copy.
if _hook_lib="$(_cast_installed cast-hook-lib.sh)" && [[ -r "$_hook_lib" ]]; then
  # shellcheck source=/dev/null
  source "$_hook_lib"
else
  _log "installed cast-hook-lib.sh missing — skipping (run: bash install.sh)"
  exit 0
fi

# ORIG_HEAD guard — squash merges and initial clones may lack ORIG_HEAD
if ! cast_git_safe "$REPO_ROOT" rev-parse --verify -q ORIG_HEAD >/dev/null 2>&1; then
  _log "no ORIG_HEAD — cannot diff, skipping"
  exit 0
fi

# Gate: check whether any CAST source directories changed
CHANGED="$(cast_git_safe "$REPO_ROOT" diff --no-renames --name-only ORIG_HEAD HEAD 2>/dev/null || echo "")"

if ! echo "$CHANGED" | grep -qE "^(agents|scripts|bin|rules-core|\.githooks)/"; then
  _log "no CAST source changes — skip reinstall"
  exit 0
fi

# CAST source changed — run install
_log "CAST source changed — starting reinstall"
echo "[CAST post-merge] CAST source changed → reinstalling (log: ~/.claude/logs/auto-install.log)" >&2

# Testability seam: override via CAST_POST_MERGE_INSTALL_CMD
# Default is built first so REPO_ROOT (which may contain spaces) is properly quoted
# when passed to eval. Tests override this by setting CAST_POST_MERGE_INSTALL_CMD.
# Use printf %q (bash 3.2-portable) instead of ${var@Q} (bash 4.4+ only) so the
# hook runs on macOS's system bash 3.2 — see cast-post-merge-hook.bats.
printf -v _default_install_cmd 'bash %q/install.sh' "$REPO_ROOT"
INSTALL_CMD="${CAST_POST_MERGE_INSTALL_CMD:-$_default_install_cmd}"

_log "running: $INSTALL_CMD"
# ACCEPTED-RISK: eval on CAST_POST_MERGE_INSTALL_CMD is intentional, not an
# oversight. It's the testability seam documented in the header comment above
# (tests set it to a harmless marker command). Setting this var requires
# writing to the operator's own environment, which is already local-compromise
# — the same trust boundary as the other CAST_* escape hatches (e.g.
# CAST_COMMIT_AGENT, CAST_PUSH_OK). No untrusted/remote input reaches this eval.
# shellcheck disable=SC2294
if eval "$INSTALL_CMD" >> "$LOG_FILE" 2>&1; then
  _log "install complete"
else
  _install_rc=$?
  _log "install FAILED (exit ${_install_rc}) — see log above; cleanup will still run"
  echo "[CAST post-merge] install.sh FAILED (exit ${_install_rc}) — check ~/.claude/logs/auto-install.log" >&2
fi

# Drop gen-stats churn: revert files dirtied by install.sh stats injection
GEN_STATS_FILES=(
  "README.md"
  "docs/README.md"
  "docs/tutorial/getting-started.md"
)

for f in "${GEN_STATS_FILES[@]}"; do
  # Only revert if the file is tracked AND currently dirty
  if cast_git_safe "$REPO_ROOT" ls-files --error-unmatch "$f" >/dev/null 2>&1 && \
     ! cast_git_safe "$REPO_ROOT" diff --quiet -- "$f" 2>/dev/null; then
    # Restore the committed blob WITHOUT `git checkout` (checkout runs smudge filters/fsmonitor
    # and writes through an agent-planted symlink): raw blob -> cast_safe_write (symlink-safe).
    if GIT_NO_LAZY_FETCH=1 GIT_ALLOW_PROTOCOL=none git -c core.fsmonitor=false -c core.hooksPath=/dev/null \
         cat-file blob "HEAD:$f" 2>/dev/null | cast_safe_write "$REPO_ROOT" "$f"; then
      _log "reverted gen-stats churn: $f"
      echo "[CAST post-merge] reverted gen-stats churn: $f" >&2
    else
      _log "could not revert gen-stats churn: $f (left as-is)"
    fi
  fi
done

_log "post-merge hook done"

# post-merge exit code is advisory — never break the merge
exit 0
