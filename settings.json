{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "MCP_CONNECTION_NONBLOCKING": "true",
    "CLAUDE_CODE_SCRIPT_CAPS": "100",
    "ATTEST_ENFORCE_AGENTS": "code-writer,bash-specialist"
  },
  "feedbackSurveyRate": 0,
  "cleanupPeriodDays": 30,
  "sandbox": {
    "failIfUnavailable": true,
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "*.googleapis.com",
        "api.anthropic.com"
      ],
      "allowLocalBinding": true,
      "allowManagedDomainsOnly": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh/id_*",
        "~/.gnupg",
        "~/.claude/cast.db",
        "~/.claude/history.jsonl",
        "~/.claude/logs/**",
        "~/.claude/routing-log.jsonl"
      ],
      "allowRead": [
        "~/.claude/cast.db"
      ]
    },
    "excludedCommands": [
      "git",
      "docker",
      "bq",
      "osascript"
    ],
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.aws/config",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.kube/config",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)"
    ],
    "deny": [
      "Agent(model:claude-fable*)",
      "Agent(model:claude-mythos*)",
      "Agent(model:fable*)",
      "Agent(model:mythos*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/.claude*)"
    ]
  },
  "modelOverrides": {
    "local-commit": "ollama/tavernari/git-commit-message",
    "local-fast": "ollama/qwen2.5-coder:7b"
  },
  "_ultracode_note": "ultracode is session-only \u2014 cannot persist in effortLevel or --effort. Optional alias: claude --settings '{\"ultracode\":true}' for a single ultracode session.",
  "model": "opus",
  "effortLevel": "xhigh",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-start-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-plan-resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-plan-resume-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-resume-inject",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-resume-inject-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-time-context",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-time-context-hook.sh",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-session-start-journal",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-start-journal.sh",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-session-start-health",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-start-health.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-user-prompt-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-tool-failure-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Agent|Bash|Task|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/post-tool-hook.sh",
            "if": "Write|Edit|Agent|Bash|Task|NotebookEdit",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Agent|Task|WebFetch|WebSearch|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-audit-hook.sh --mode post",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-instructions-loaded-hook.sh",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-audit-hook.sh --mode pre",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-pretool-dispatch",
        "matcher": "mcp__.*|WebFetch|WebSearch|Bash|Read|Write|Edit|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/cast-pretool-dispatch.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-headless-guard.sh",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-write-guards",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/write-guards.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate whether this file change could expose secrets, weaken authentication, or leak sensitive data. If the change is dangerous, respond with BLOCK and explain why. If safe, respond with ALLOW.",
            "if": "Write(**/.env*|**/auth/**|**/credentials*|**/secrets*)"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate whether this file change could expose secrets, weaken authentication, or leak sensitive data. If the change is dangerous, respond with BLOCK and explain why. If safe, respond with ALLOW.",
            "if": "Edit(**/.env*|**/auth/**|**/credentials*|**/secrets*)"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "id": "cast-cwd-changed",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-cwdchanged-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "id": "cast-file-changed",
        "matcher": ".envrc|.env|.cast|cast.json",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-filechanged-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "id": "cast-precompact-guard",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-precompact-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "id": "cast-precompact-memory-save",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-precompact-memory-save.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "cast-journal-session-end",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-journal-session-end.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-end.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-subagent-start-hook.sh",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "id": "cast-subagent-stop",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-subagent-stop-hook.sh",
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "id": "cast-subagent-worktree-check",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-subagent-worktree-check.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-stop-failure-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-post-compact-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Context was automatically compacted. Briefly let the user know this happened, summarize the current task state, and continue where you left off."
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-task-created-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-teammate-idle-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-task-completed-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "mcpServers": {},
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      "dist"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/cast-statusline.sh 2>/dev/null || echo 'CAST ready'"
  },
  "autoUpdatesChannel": "stable",
  "plansDirectory": "~/.claude/plans/",
  "_permissions_warning": "REVIEW CAREFULLY: Bash/Write/Edit let Claude act without asking. Remove any you're not comfortable with.",
  "_routing_note": "Model routing: haiku for commit/push/code-reviewer/test-runner. opus is the default (set in 16-model-defaults.json). Set CLAUDE_CODE_SUBAGENT_MODEL to override globally. Effort levels: see agent frontmatter.",
  "teammateMode": "in-process",
  "_sandbox_note": "PARTIALLY LIVE (updated 2026-07-02, CC 2.1.195): filesystem denyRead DOES enforce in sessions where CC engages the Seatbelt sandbox \u2014 proven by EPERM on cast.db reads in a live interactive session (2026-07-02 doctor probe). Enforcement is session/permission-mode-dependent: explicitly-allowed and bypass-permissions commands run unsandboxed, so probes from autonomous sessions may observe no denial \u2014 verify from an interactive default-mode session. excludedCommands does NOT bypass filesystem.denyRead. filesystem.allowRead wins over denyRead: cast.db is allowlisted (Ed decision 2026-07-02) so cast status and /doctor read real data; history.jsonl, logs/**, and routing-log.jsonl stay denied. The egress PreToolUse hook (logs/egress.jsonl) remains the only live egress enforcement. Note: CC does not natively read managed-settings.d/; cast-merge-settings.sh merges this into ~/.claude/settings.json (user layer, not tamper-proof MDM). Verify ENFORCEMENT, not key-presence."
}
