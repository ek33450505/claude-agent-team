{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "MCP_CONNECTION_NONBLOCKING": "true"
  },
  "feedbackSurveyRate": 0,
  "cleanupPeriodDays": 30,
  "sandbox": {
    "failIfUnavailable": true,
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "*.googleapis.com",
        "api.anthropic.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh/id_*",
        "~/.gnupg",
        "~/.claude/cast.db",
        "~/.claude/history.jsonl",
        "~/.claude/logs/**",
        "~/.claude/routing-log.jsonl"
      ]
    },
    "excludedCommands": [
      "git",
      "docker",
      "bq",
      "osascript"
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)"
    ]
  },
  "modelOverrides": {
    "local-commit": "ollama/tavernari/git-commit-message",
    "local-fast": "ollama/qwen2.5-coder:7b"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-start-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "id": "cast-time-context",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-time-context-hook.sh",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-session-start-journal",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-start-journal.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-user-prompt-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-tool-failure-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/post-tool-hook.sh",
            "if": "Write|Edit|Agent|Bash",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-budget-alert.sh",
            "if": "Bash|Edit|Write|Agent",
            "timeout": 3,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:3001/api/hook-events",
            "method": "POST",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-instructions-loaded-hook.sh",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-audit-hook.sh",
            "if": "Write|Edit",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/pre-tool-guard.sh",
            "if": "Bash(git *)",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-headless-guard.sh",
            "timeout": 3
          }
        ]
      },
      {
        "id": "cast-stat-claim-guard",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-stat-claim-guard.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate whether this file change could expose secrets, weaken authentication, or leak sensitive data. If the change is dangerous, respond with BLOCK and explain why. If safe, respond with ALLOW.",
            "if": "Write(**/.env*) || Write(**/auth/**) || Write(**/credentials*) || Write(**/secrets*) || Edit(**/.env*) || Edit(**/auth/**) || Edit(**/credentials*) || Edit(**/secrets*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Before allowing this git push, check: 1) Are there uncommitted changes? 2) Is this pushing to main/master? If pushing to main, run the test suite (bats tests/ from the repo root) and verify no regressions. Report ALLOW or BLOCK with reason.",
            "if": "Bash(git push*)",
            "timeout": 120
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "id": "cast-cwd-changed",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-cwdchanged-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "id": "cast-file-changed",
        "matcher": ".envrc|.env|.cast|cast.json",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-filechanged-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "id": "cast-precompact-guard",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-precompact-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "id": "cast-precompact-memory-save",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-precompact-memory-save.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "cast-journal-session-end",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-journal-session-end.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-end.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-session-end.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-subagent-start-hook.sh",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "id": "cast-subagent-stop",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-subagent-stop-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "id": "cast-response-completeness",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-response-completeness-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-stop-failure-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-post-compact-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Context was automatically compacted. Briefly let the user know this happened, summarize the current task state, and continue where you left off."
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/cast-task-created-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "_cast_channel_server": {
    "_note": "CAST channel event bus \u2014 HTTP server at http://127.0.0.1:9200. Start with: cast-channel-start.sh",
    "_endpoints": {
      "POST /publish": "Receive a JSON event from hook scripts",
      "GET /events": "Return last N events as JSON (?limit=10)",
      "GET /events/stream": "SSE stream of new events",
      "GET /health": "Status and event count"
    },
    "_publish_from_bash": "source ~/.claude/scripts/cast-channel-publish.sh && cast_channel_publish '{\"type\":\"hook\",\"tool_name\":\"Bash\"}'",
    "_upgrade_path": "This will be registered as a proper MCP server when the MCP spec supports local HTTP servers natively"
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      "dist"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/cast-stats.sh --brief 2>/dev/null | head -1 || echo 'CAST ready'"
  },
  "autoUpdatesChannel": "stable",
  "plansDirectory": "~/.claude/plans/",
  "_permissions_warning": "REVIEW CAREFULLY: Bash/Write/Edit let Claude act without asking. Remove any you're not comfortable with.",
  "_routing_note": "Model routing: haiku for commit/push/code-reviewer/test-runner. sonnet for all others. Set CLAUDE_CODE_SUBAGENT_MODEL to override globally. Effort levels: see agent frontmatter.",
  "teammateMode": "in-process",
  "model": "sonnet"
}
